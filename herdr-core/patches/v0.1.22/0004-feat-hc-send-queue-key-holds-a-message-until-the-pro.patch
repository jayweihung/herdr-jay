diff --git a/crates/herdr-core/tests/queue.rs b/crates/herdr-core/tests/queue.rs
new file mode 100644
index 0000000..74bbbae
--- /dev/null
+++ b/crates/herdr-core/tests/queue.rs
@@ -0,0 +1,35 @@
+#![cfg(unix)] // Windows: tests/windows.rs
+
+mod common;
+
+use common::*;
+
+fn session() -> Session {
+    let mut s = Session::new();
+    s.env.push(("HC_QUIET_MS".into(), "0".into()));
+    s.env.push(("HC_STARTED_MS".into(), "1500".into()));
+    s
+}
+
+#[test]
+fn a_queued_send_waits_until_work_stops_keeps_one_per_key_and_clears_when_its_turn_ends() {
+    let s = session();
+    let body = "r state=working; w a; r state=done; IFS= read -r line; echo \"got $line\"; r state=working; w b; r state=done; sleep 100";
+    let t = s.json(&["run", "--bg", "sh", "-c", &script(&s, body)])["address"].as_str().unwrap().to_string();
+    wait_until("working", || get(&s, &t)["status"]["state"] == "working");
+
+    let r = s.json(&["send", "--queue", "--key", "compact", &t, "/compact one"]);
+    assert_eq!(r["queued"], true, "{r}");
+    s.json(&["send", "--queue", "--key", "compact", &t, "/compact two"]);
+    let queued = get(&s, &t)["queued"].clone();
+    assert_eq!(queued.as_array().map(Vec::len), Some(1), "one per key: {queued}");
+    assert_eq!((queued[0]["text"].as_str(), queued[0]["state"].as_str()), (Some("/compact two"), Some("queued")));
+
+    touch(&s, "a"); // it stops working: the queued text goes in
+    wait_until("typed", || text(&s, &t).contains("got /compact two"));
+    wait_until("sent", || get(&s, &t)["queued"][0]["state"] == "sent");
+    assert!(!text(&s, &t).contains("/compact one"), "the replaced one never went in");
+
+    touch(&s, "b"); // the turn it started ends: the entry goes
+    wait_until("cleared", || get(&s, &t).get("queued").is_none());
+}
