Subject: [PATCH 18/26] feat: layout() marks the node layout.zoom shows alone
 with zoomed: true

---
 defaults/herdr.d.ts |  3 ++-
 src/mods.rs         | 19 +++++++++++++++++--
 src/window.rs       |  2 +-
 3 files changed, 20 insertions(+), 4 deletions(-)

diff --git a/defaults/herdr.d.ts b/defaults/herdr.d.ts
index ee3a82e..73dede6 100644
--- a/defaults/herdr.d.ts
+++ b/defaults/herdr.d.ts
@@ -272,7 +272,8 @@ export function focused(): ({ space: string; tab: string; pane: string | null; t
 /** The shown layout (layouts/<name>.json). Its name is shared("layout").
  *  Root `terminal_menu?: string` chooses a terminal right-click menu mod (default: "menu").
  *  Unknown names warn and fall back to "menu". This replaces the menu, not its items.
- *  Opens a pointer popup with mod.json overlay width/height (default 220×260). */
+ *  Opens a pointer popup with mod.json overlay width/height (default 220×260).
+ *  The node layout.zoom shows alone has `zoomed: true` (not in the file). */
 export function layout(): unknown;
 
 /** The names of every layout in layouts/ (main first). */
diff --git a/src/mods.rs b/src/mods.rs
index 6b3cdb4..6dfdb2c 100644
--- a/src/mods.rs
+++ b/src/mods.rs
@@ -609,8 +609,23 @@ fn publish(key: &'static str, set: impl FnOnce(&mut Snapshot) -> (Value, Value))
     changed
 }
 
-pub fn publish_layout(layout: &Node) -> bool {
-    let v = serde_json::to_value(layout).unwrap_or(Value::Null);
+/// `zoomed`: the node layout.zoom shows alone, marked `"zoomed": true` (it isn't in the file).
+pub fn publish_layout(layout: &Node, zoomed: Option<&str>) -> bool {
+    fn mark(v: &mut Value, id: &str) -> bool {
+        match v {
+            Value::Object(o) if o.get("id").and_then(Value::as_str) == Some(id) => {
+                o.insert("zoomed".into(), Value::Bool(true));
+                true
+            }
+            Value::Object(o) => o.values_mut().any(|c| mark(c, id)),
+            Value::Array(a) => a.iter_mut().any(|c| mark(c, id)),
+            _ => false,
+        }
+    }
+    let mut v = serde_json::to_value(layout).unwrap_or(Value::Null);
+    if let Some(id) = zoomed {
+        mark(&mut v, id);
+    }
     publish("layout", |s| (std::mem::replace(&mut s.layout, v.clone()), v))
 }
 pub fn publish_machines(v: Value) -> bool {
diff --git a/src/window.rs b/src/window.rs
index 2303571..152f063 100644
--- a/src/window.rs
+++ b/src/window.rs
@@ -1910,7 +1910,7 @@ impl AppWindow {
         changed |= mods::publish_panes(Value::Array(panes));
         changed |= mods::publish_focused(focused.unwrap_or(Value::Null));
         changed |= mods::publish_floats(self.float_placements());
-        changed |= mods::publish_layout(&self.chrome);
+        changed |= mods::publish_layout(&self.chrome, self.zoom_hid.as_ref().map(|(id, _)| id.as_str()));
         if changed {
             self.refresh_snapshot_mods(cx);
         }
