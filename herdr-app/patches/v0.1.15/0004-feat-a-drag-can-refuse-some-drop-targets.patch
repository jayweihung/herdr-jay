     fn render(&mut self, _: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
         let colors = Theme::global(cx).tokens.colors;
+        let refused = CHIP_REFUSED.get();
+        let label = if refused { self.refused_label.clone() } else { self.label.clone() };
         div()
             .pl(self.offset.x + scaled_px(14.))
             .pt(self.offset.y + scaled_px(10.))
@@ -74,28 +174,56 @@ impl Render for Chip {
                     .text_size(scaled_px(12.))
                     .shadow_md()
                     .truncate()
-                    .child(self.label.clone()),
+                    .when(refused, |chip| chip.text_color(colors.muted_foreground))
+                    .child(label),
+            )
+            // Painted after every other element: a window-wide cursor asked
+            // for here is the one the window shows.
+            .child(
+                canvas(
+                    |_, _, _| (),
+                    |_, _, window, _| {
+                        let refused = REFUSED_UNDER_POINTER.replace(false);
+                        if refused {
+                            window.set_window_cursor_style(CursorStyle::OperationNotAllowed);
+                        }
+                        if CHIP_REFUSED.replace(refused) != refused {
+                            window.on_next_frame(|window, _| window.refresh());
+                        }
+                    },
+                )
+                .absolute()
+                .size_0(),
             )
     }
 }
 
