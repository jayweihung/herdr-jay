+    #[test]
+    fn check_names_what_must_be_installed_when_run_starts_a_launcher() {
+        let mut claude = Entry { run: vec!["claude".into()], ..Entry::default() };
+        claude.over(Entry { run: vec!["kit".into(), "open".into(), "claude".into()], check: Some("claude".into()), ..Entry::default() });
+        let mut codex = Entry { run: vec!["codex".into()], ..Entry::default() };
+        codex.over(Entry { name: Some("Mine".into()), ..Entry::default() });
+        let mut table = t();
+        table.programs.insert("claude".into(), claude);
+        table.programs.insert("codex".into(), codex);
+        let before = TABLE.with(|x| x.replace(table));
+        let list = startable();
+        TABLE.with(|x| x.replace(before));
+        let of = |k: &str| list.iter().find(|a| a["key"] == k).cloned().unwrap();
+        assert_eq!(of("claude")["run"], json!(["kit", "open", "claude"]));
+        assert_eq!(of("claude")["check"], "claude");
+        assert_eq!(of("codex")["check"], "codex");
+    }
