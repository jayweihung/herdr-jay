-    let dead: Vec<Key> = VIEWS.with_borrow(|v| v.iter().filter(|(k, view)| view.page.window() == here && !frame.alive.contains(&k.copy)).map(|(k, _)| k.clone()).collect());
+    let dead: Vec<Key> = with_views(|v| v.iter().filter(|(k, view)| view.page.window() == here && !frame.alive.contains(&k.copy)).map(|(k, _)| k.clone()).collect());
     for key in dead {
