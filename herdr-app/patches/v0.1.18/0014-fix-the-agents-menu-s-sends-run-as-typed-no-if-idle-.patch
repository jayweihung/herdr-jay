       })
-      .child(div().px(8).pt(4).pb(6).text_size(11).text_color(t.dim).truncate().child(a.title || a.program?.name || a.address))
+      .child(div().px(8).pt(4).pb(6).text_size(11).text_color(t.dim).truncate().child(nameOf(a)))
       .children(list.map((it, i) => v_flex()
         .when(it[1] === "pin" || (it[1].startsWith("mod:") && !list[i - 1][1].startsWith("mod:")), (el) => el.child(div().mx(7).my(4).h(1).bg(t.border)))
         .child(h_flex()
@@ -269,23 +273,23 @@ export default class Agents extends View {
           .when(i === this.at && !it[2], (el) => el.bg(t.selected))
           .when(!it[2], (el) => el.cursor_pointer().hover((s) => s.bg(t.hover)))
           .on_click((_e, cx) => pick(i, cx))
-          .child(v_flex().flex_1().min_w(0)
-            .child(div().child(this.asking === it[1] ? it[3] : it[0]))
-            .when(Boolean(it[2]), (el) => el.child(div().text_size(11).text_color(t.dim).child(it[2])))))));
+          .child(div().flex_1().min_w(0).child(this.asking === it[1] ? it[3] : it[0]))
+          .when(Boolean(it[2]), (el) => el.child(div().flex_none().text_size(11).text_color(t.dim).child(it[2]))))));
   }
 
   // what a menu item does (the agent: as agents() lists it)
-  act(a, what) {
+  act(a, what, name) {
     const say = (r, done) => {
-      if (r?.code === 0) return;
+      if (r?.code === 0) return notify({ title: `已${done}`, body: name, level: "success", timeout: 3000 });
       notify({ title: `沒有${done}`, body: (r?.stderr || r?.stdout || "hc 沒有回應").trim().slice(0, 300), level: "warning" });
     };
     const cmds = TOOL_CMDS[toolOf(a)] ?? {};
-    if (what === "compact") hc(sendTo(a, cmds.compact)).then((r) => say(r, "壓縮"), () => say(null, "壓縮"));
-    else if (what === "clear") hc(sendTo(a, cmds.clear)).then((r) => say(r, "清空"), () => say(null, "清空"));
-    else if (what === "continue") hc(sendTo(a, "繼續")).then((r) => say(r, "送出「繼續」"), () => say(null, "送出「繼續」"));
-    else if (what === "stop") hc(["interrupt", a.address]).then((r) => say(r, "停下來"), () => say(null, "停下來"));
-    else if (what === "pin") run("terminal.pin", { terminal: a.address, pinned: !a.pinned });
+    const send = (args, done) => hc(args).then((r) => say(r, done), () => say(null, done));
+    if (what === "compact") return send(sendTo(a, cmds.compact), "送出壓縮");
+    if (what === "clear") return send(sendTo(a, cmds.clear), "送出清空");
+    if (what === "continue") return send(sendTo(a, "繼續"), "送出「繼續」");
+    if (what === "stop") return send(["interrupt", a.address], "叫它停下來");
+    if (what === "pin") run("terminal.pin", { terminal: a.address, pinned: !a.pinned });
     else if (what === "close") run("pane.close", { pane: a.pane });
     else if (what.startsWith("mod:")) {
       const [, mod, id] = what.split(":");
