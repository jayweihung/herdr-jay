+    /// Agents ("a:idle b:working") and what else their records say (the panel's
+    /// agents and terminals, in one record each here); a record without an agent
+    /// reports no status.
+    fn records(agents: &str, terms: &[Value]) -> Vec<Value> {
+        let mut out: Vec<Value> = agents
+            .split_whitespace()
+            .map(|x| {
+                let (a, s) = x.split_once(':').unwrap();
+                json!({"address": a, "state": "live", "status": {"state": s}})
+            })
+            .collect();
+        for t in terms {
+            match out.iter_mut().find(|r| r["address"] == t["address"]) {
+                Some(r) => r.as_object_mut().unwrap().extend(t.as_object().unwrap().clone()),
+                None => {
+                    let mut t = t.clone();
+                    t["state"] = "live".into();
+                    out.push(t);
+                }
+            }
+        }
+        out
+    }
+
+    fn msg(to: &str, at: u64) -> Value {
+        json!({"to": to, "count": 1, "last_ms": at, "text": "x"})
+    }
+
+    fn history(words: &[(&str, u64)]) -> Value {
+        words.iter().map(|(s, at)| json!({"state": s, "at_ms": at})).collect()
+    }
+
+    /// `records` with one record's fields replaced.
+    fn with(terms: &[Value], address: &str, fields: Value) -> Vec<Value> {
+        let mut terms = terms.to_vec();
+        match terms.iter_mut().find(|t| t["address"] == address) {
+            Some(t) => t.as_object_mut().unwrap().extend(fields.as_object().unwrap().clone()),
+            None => {
+                let mut t = fields;
+                t["address"] = address.into();
+                terms.push(t);
+            }
+        }
+        terms
+    }
