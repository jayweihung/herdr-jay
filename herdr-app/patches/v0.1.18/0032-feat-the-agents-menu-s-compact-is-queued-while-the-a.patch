+
+test("a compact: queued while the agent works, typed in once it waits, ended by a turn after it or a timeout", () => {
+  const { compactStep, compactLive } = new Function("View", `${source}; return { compactStep, compactLive };`)(class {});
+  const queued = { state: "queued", at: 1000, text: "/compact" };
+  expect(compactStep(null, "idle", 3, 2000)).toBe(null);
+  expect(compactStep(queued, "working", 3, 2000)).toBe(null);
+  expect(compactStep(queued, "blocked", 3, 2000)).toBe(null);
+  expect(compactStep(queued, "idle", 3, 2000)).toBe("send");
+  expect(compactStep(queued, "done", 3, 2000)).toBe("send");
+  expect(compactStep(queued, "working", 3, 1000 + 1800001)).toBe("timeout");
+  const sent = { ...queued, state: "sent", sent: 5000, turn: 3 };
+  expect(compactStep(sent, "done", 3, 6000)).toBe(null); // typed in, not started yet
+  expect(compactStep(sent, "working", 4, 6000)).toBe(null); // compacting
+  expect(compactStep(sent, "done", 4, 6000)).toBe("done");
+  expect(compactStep({ ...sent, turn: null }, "done", 4, 6000)).toBe(null); // no turn known: only the timeout ends it
+  expect(compactStep(sent, "done", 3, 5000 + 180001)).toBe("timeout");
+  expect(compactStep(sent, "done", 3, 5000 + 180000 + 600001)).toBe("drop"); // left from long ago (a restart)
+  expect([compactLive(null, 6000), compactLive(queued, 6000), compactLive(sent, 6000), compactLive(sent, 5000 + 180001)]).toEqual([false, true, true, false]);
+});
+
+test("the menu's 壓縮: offered while it works (queued), says what its compact is doing, not while it needs you", () => {
+  const { menuItems, withBusy } = new Function("View", `${source}; return { menuItems, withBusy };`)(class {});
+  const claude = { address: "t1", app: "claude-code", program: { key: "claude" } };
+  const item = (a: any, job: any = null) => menuItems(a, {}, 2000, job)[0].slice(0, 3);
+  expect(item({ ...claude, status: "idle" })).toEqual(["壓縮", "compact", ""]);
+  expect(item({ ...claude, status: "working" })).toEqual(["壓縮（這輪結束後）", "compact", ""]);
+  expect(item({ ...claude, status: "blocked" })).toEqual(["壓縮", "compact", "等你回答"]);
+  expect(item({ address: "t2", status: "idle", program: { key: "shell" } })[2]).toBe("不支援");
+  expect(item({ ...claude, status: "working" }, { state: "queued", at: 1000 })).toEqual(["已排隊，這輪結束後壓縮", "compact", ""]);
+  expect(item({ ...claude, status: "working" }, { state: "sent", at: 1000, sent: 1500 })).toEqual(["壓縮中…", "compact", ""]);
+  // done while its own work still runs (shared agents.busy): working, so its compact is queued
+  expect(withBusy({ ...claude, status: "done" }, { t1: "Bash" }).status).toBe("working");
+  expect(withBusy({ ...claude, status: "done" }, {}).status).toBe("done");
+});
