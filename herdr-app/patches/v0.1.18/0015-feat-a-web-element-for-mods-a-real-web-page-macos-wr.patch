+define_class!(
+    // SAFETY: NSObject has no subclassing requirements; no Drop impl.
+    #[unsafe(super(NSObject))]
+    #[thread_kind = MainThreadOnly]
+    #[ivars = Rc<Status>]
+    struct NavDelegate;
+
+    unsafe impl NSObjectProtocol for NavDelegate {}
+
+    unsafe impl WKNavigationDelegate for NavDelegate {
+        #[unsafe(method(webView:decidePolicyForNavigationAction:decisionHandler:))]
+        fn decide_action(&self, _web: &WKWebView, action: &WKNavigationAction, handler: &block2::DynBlock<dyn Fn(WKNavigationActionPolicy)>) {
+            let s = self.ivars();
+            let request = unsafe { action.request() };
+            let url = request.URL().and_then(|u| u.absoluteString()).map(|u| u.to_string()).unwrap_or_default();
+            // No target frame: a new window, which the UI delegate already opened here.
+            let main = unsafe { action.targetFrame() }.is_none_or(|f| unsafe { f.isMainFrame() });
+            let download = action.respondsToSelector(sel!(shouldPerformDownload)) && unsafe { action.shouldPerformDownload() };
+            // Frames follow the site's own CSP; only the top level is held to mod.json.
+            let allow = if download {
+                super::download(&s.key, &url);
+                false
+            } else {
+                !main || super::top_level(&s.key, &s.rules, &url)
+            };
+            handler.call((if allow { WKNavigationActionPolicy::Allow } else { WKNavigationActionPolicy::Cancel },));
+        }
+
+        #[unsafe(method(webView:decidePolicyForNavigationResponse:decisionHandler:))]
+        fn decide_response(&self, _web: &WKWebView, response: &WKNavigationResponse, handler: &block2::DynBlock<dyn Fn(WKNavigationResponsePolicy)>) {
+            let (main, shows, r) = unsafe { (response.isForMainFrame(), response.canShowMIMEType(), response.response()) };
+            let attachment = r
+                .downcast_ref::<NSHTTPURLResponse>()
+                .and_then(|h| unsafe { h.valueForHTTPHeaderField(ns_string!("Content-Disposition")) })
+                .is_some_and(|v| v.to_string().trim_start().to_ascii_lowercase().starts_with("attachment"));
+            if main && (!shows || attachment) {
+                let url = r.URL().and_then(|u| u.absoluteString()).map(|u| u.to_string()).unwrap_or_default();
+                super::download(&self.ivars().key, &url);
+                handler.call((WKNavigationResponsePolicy::Cancel,));
+            } else {
+                handler.call((WKNavigationResponsePolicy::Allow,));
+            }
+        }
+
+        #[unsafe(method(webView:didStartProvisionalNavigation:))]
+        fn did_start(&self, web: &WKWebView, _nav: Option<&WKNavigation>) {
+            super::emit(&self.ivars().key, "loading", json!({ "url": url_of(web) }));
+        }
+
+        #[unsafe(method(webView:didCommitNavigation:))]
+        fn did_commit(&self, web: &WKWebView, _nav: Option<&WKNavigation>) {
+            if let Some(url) = url_of(web) {
+                self.ivars().url_changed(url);
+            }
+        }
+
+        #[unsafe(method(webView:didFinishNavigation:))]
+        fn did_finish(&self, web: &WKWebView, _nav: Option<&WKNavigation>) {
+            self.ivars().revived.set(false);
+            super::emit(&self.ivars().key, "loaded", json!({ "url": url_of(web) }));
+        }
+
+        #[unsafe(method(webView:didFailNavigation:withError:))]
+        fn did_fail(&self, web: &WKWebView, _nav: Option<&WKNavigation>, error: &NSError) {
+            self.failed(web, error);
+        }
+
+        #[unsafe(method(webView:didFailProvisionalNavigation:withError:))]
+        fn did_fail_provisional(&self, web: &WKWebView, _nav: Option<&WKNavigation>, error: &NSError) {
+            self.failed(web, error);
+        }
+
+        #[unsafe(method(webViewWebContentProcessDidTerminate:))]
+        fn did_terminate(&self, web: &WKWebView) {
+            let s = self.ivars();
+            super::emit(&s.key, "crashed", json!({ "url": url_of(web) }));
+            if !s.revived.replace(true) {
+                unsafe { web.reload() };
+            }
+        }
+    }
+);
+
+impl NavDelegate {
+    fn new(mtm: MainThreadMarker, status: Rc<Status>) -> Retained<Self> {
+        let this = mtm.alloc::<NavDelegate>().set_ivars(status);
+        unsafe { msg_send![super(this), init] }
+    }
+
+    fn failed(&self, web: &WKWebView, error: &NSError) {
+        let (domain, code) = (error.domain().to_string(), error.code());
+        // Not failures: a load replaced by another (-999), and one stopped by
+        // policy (102: a download or a link sent to the browser; 204: media
+        // handed to a plug-in).
+        if (domain == "NSURLErrorDomain" && code == -999) || (domain == "WebKitErrorDomain" && matches!(code, 102 | 204)) {
+            return;
+        }
+        super::emit(&self.ivars().key, "failed", json!({ "url": url_of(web), "error": error.localizedDescription().to_string() }));
+    }
+}
+
+define_class!(
+    // SAFETY: NSObject has no subclassing requirements; no Drop impl.
+    #[unsafe(super(NSObject))]
+    #[thread_kind = MainThreadOnly]
+    #[ivars = Rc<Status>]
+    struct UiDelegate;
+
+    unsafe impl NSObjectProtocol for UiDelegate {}
+
+    unsafe impl WKUIDelegate for UiDelegate {
+        /// target=_blank and window.open: an allowed page loads in this one
+        /// (no second view), anything else opens in the system browser.
+        #[unsafe(method_id(webView:createWebViewWithConfiguration:forNavigationAction:windowFeatures:))]
+        fn new_window(&self, web: &WKWebView, _config: &WKWebViewConfiguration, action: &WKNavigationAction, _features: &WKWindowFeatures) -> Option<Retained<WKWebView>> {
+            let s = self.ivars();
+            let url = unsafe { action.request() }.URL().and_then(|u| u.absoluteString()).map(|u| u.to_string()).unwrap_or_default();
+            if !url.is_empty() && !url.starts_with("about:") && super::top_level(&s.key, &s.rules, &url) {
+                load_into(web, &url, &s.rules);
+            }
+            None
+        }
+
+        /// The microphone (speech input too) and camera: granted to allowed
+        /// origins (asked of the page and the frame), refused to others.
+        /// macOS still asks the person once for Herdr itself.
+        #[unsafe(method(webView:requestMediaCapturePermissionForOrigin:initiatedByFrame:type:decisionHandler:))]
+        fn media(&self, _web: &WKWebView, origin: &WKSecurityOrigin, frame: &WKFrameInfo, _kind: WKMediaCaptureType, handler: &block2::DynBlock<dyn Fn(WKPermissionDecision)>) {
+            let rules = &self.ivars().rules;
+            let frame_origin = unsafe { frame.securityOrigin() };
+            let ok = allowed_origin(rules, origin) && allowed_origin(rules, &frame_origin);
+            handler.call((if ok { WKPermissionDecision::Grant } else { WKPermissionDecision::Deny },));
+        }
+
+        /// `<input type=file>`: the system's file picker.
+        #[unsafe(method(webView:runOpenPanelWithParameters:initiatedByFrame:completionHandler:))]
+        fn open_panel(&self, _web: &WKWebView, params: &WKOpenPanelParameters, _frame: &WKFrameInfo, handler: &block2::DynBlock<dyn Fn(*mut NSArray<NSURL>)>) {
+            let panel = NSOpenPanel::openPanel(self.mtm());
+            panel.setCanChooseFiles(true);
+            unsafe {
+                panel.setAllowsMultipleSelection(params.allowsMultipleSelection());
+                panel.setCanChooseDirectories(params.allowsDirectories());
+            }
+            if panel.runModal() == NSModalResponseOK {
+                handler.call((Retained::as_ptr(&panel.URLs()).cast_mut(),));
+            } else {
+                handler.call((std::ptr::null_mut(),));
+            }
+        }
+    }
+);
+
+impl UiDelegate {
+    fn new(mtm: MainThreadMarker, status: Rc<Status>) -> Retained<Self> {
+        let this = mtm.alloc::<UiDelegate>().set_ivars(status);
+        unsafe { msg_send![super(this), init] }
+    }
+}
+
+/// A WebKit security origin that mod.json allows.
+fn allowed_origin(rules: &Rules, origin: &WKSecurityOrigin) -> bool {
+    let (scheme, host, port) = unsafe { (origin.protocol().to_string(), origin.host().to_string(), origin.port()) };
+    let port = if port > 0 { format!(":{port}") } else { String::new() };
+    scheme != "file" && rules.decide(&format!("{scheme}://{host}{port}/")) == super::Nav::Allow
+}
+
+struct UrlIvars {
+    view: Retained<WKWebView>,
+    status: Rc<Status>,
+}
+
+define_class!(
+    // SAFETY: NSObject has no subclassing requirements; Drop only removes the
+    // observation it added.
+    #[unsafe(super(NSObject))]
+    #[thread_kind = MainThreadOnly]
+    #[ivars = UrlIvars]
+    struct UrlObserver;
+
+    impl UrlObserver {
+        #[unsafe(method(observeValueForKeyPath:ofObject:change:context:))]
+        fn observe(&self, key_path: Option<&NSString>, _object: Option<&AnyObject>, _change: Option<&NSDictionary<NSKeyValueChangeKey, AnyObject>>, _context: *mut c_void) {
+            if key_path.is_some_and(|k| k.to_string() == "URL")
+                && let Some(url) = url_of(&self.ivars().view)
+            {
+                self.ivars().status.url_changed(url);
+            }
+        }
+    }
+
+    unsafe impl NSObjectProtocol for UrlObserver {}
+);
+
+impl UrlObserver {
+    fn new(mtm: MainThreadMarker, view: Retained<WKWebView>, status: Rc<Status>) -> Retained<Self> {
+        let this = mtm.alloc::<UrlObserver>().set_ivars(UrlIvars { view, status });
+        let this: Retained<Self> = unsafe { msg_send![super(this), init] };
+        unsafe { this.ivars().view.addObserver_forKeyPath_options_context(&this, ns_string!("URL"), NSKeyValueObservingOptions::New, std::ptr::null_mut()) };
+        this
+    }
+}
+
+impl Drop for UrlObserver {
+    fn drop(&mut self) {
+        unsafe { self.ivars().view.removeObserver_forKeyPath(self, ns_string!("URL")) };
+    }
+}
