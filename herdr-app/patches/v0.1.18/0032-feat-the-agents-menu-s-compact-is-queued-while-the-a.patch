+// still calls done (the list shows a done agent you've looked at as idle; hc's --if knows only idle and working)
 export const sendTo = (a, text) => ["send", a.address, text];
+// An agent whose turn ended while work of its own still runs (a background command, a sub-agent) isn't done yet:
+// another mod that sees it (the kit mod) puts it in shared "agents.busy" (address -> what runs); it counts as working.
+export const withBusy = (a, busy) => (a.status === "done" && busy?.[a.address] ? { ...a, status: "working" } : a);
+// One /compact per agent per cycle, shared with the kit mod (its context.js has the same; keep the two the same):
+// shared "compact/<address>" = { state: "queued" | "sent", at, text, sent?, turn? } while one waits or runs, else null.
+// A queued one is typed in once the agent waits (idle, done); a sent one ends when a turn ends after it (the core's
+// turn goes up each time it stops working: /compact works, then stops), or the kit mod sees kit context say
+// "compacted", or after COMPACT_SENT ms.
+export const COMPACT_SENT = 180000, COMPACT_QUEUED = 1800000;
+export const compactKey = (address) => `compact/${address}`;
+// one of these (null, or another mod's mistake, is none: a press replaces it)
+const isCompact = (e) => (e?.state === "queued" || e?.state === "sent") && Number.isFinite(e.at);
+// what to do about it now: "send", "done", "timeout" (say so), "drop" (left from long ago: clear quietly), or null
+export function compactStep(e, status, turn, now = Date.now()) {
+  if (!isCompact(e)) return null;
+  const sent = e.state === "sent", since = now - (sent ? e.sent ?? e.at : e.at), ttl = sent ? COMPACT_SENT : COMPACT_QUEUED;
+  if (since > ttl + 600000) return "drop";
+  if (since > ttl) return "timeout";
+  const waits = status === "idle" || status === "done";
+  if (!sent) return waits ? "send" : null;
+  return waits && Number.isFinite(turn) && Number.isFinite(e.turn) && turn > e.turn ? "done" : null;
+}
+// one is queued or running: another press only says so
+export const compactLive = (e, now = Date.now()) => isCompact(e) && compactStep(e, null, null, now) === null;
