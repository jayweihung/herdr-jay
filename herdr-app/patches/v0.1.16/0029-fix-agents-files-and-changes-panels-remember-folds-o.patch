+  // What you picked and typed per folder (localStorage "kept"; the 50 folders used last).
+  kept() {
+    try { const m = JSON.parse(localStorage.getItem("kept") ?? "{}"); return m && typeof m === "object" && !Array.isArray(m) ? m : {}; }
+    catch { return {}; }
+  }
+
+  keep() {
+    if (!this.context) return;
+    const m = this.kept();
+    delete m[this.context];
+    if (this.open || this.closed || this.message) m[this.context] = { open: this.open, closed: this.closed, message: this.message };
+    const keys = Object.keys(m);
+    for (const k of keys.slice(0, Math.max(0, keys.length - 50))) delete m[k];
