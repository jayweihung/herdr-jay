+// HERDR: whether a string child being built here is ordinary text a person can
+// select and copy. Set by each node for its own children (see
+// `keeps_text_selectable`); a run of text reads its parent's answer.
+thread_local! {
+    static SELECTABLE_TEXT: Cell<bool> = const { Cell::new(true) };
+}
+
+/// Sets whether string children are selectable until dropped, then puts the
+/// previous answer back, unwinding included.
+struct SelectableTextScope(bool);
+
+impl SelectableTextScope {
+    fn enter(selectable: bool) -> Self {
+        Self(SELECTABLE_TEXT.with(|s| s.replace(selectable)))
+    }
+}
+
+impl Drop for SelectableTextScope {
+    fn drop(&mut self) {
+        SELECTABLE_TEXT.with(|s| s.set(self.0));
+    }
+}
+
+/// Runs `build` with string children selectable or not.
+fn with_selectable_text<T>(selectable: bool, build: impl FnOnce() -> T) -> T {
+    let _scope = SelectableTextScope::enter(selectable);
+    build()
+}
+
+/// HERDR: whether text under this node stays selectable.
+///
+/// Layout containers keep it. A control owns its label (a button, a tab, a
+/// checkbox, a select: pressing there is using the control), and so does an
+/// element that handles the left press itself, starts a drag or is a dock's
+/// tab or button, because a press-and-move there is that element's gesture,
+/// not a selection.
+/// Registered and module components draw their children their own way, so
+/// theirs stay plain too.
+fn keeps_text_selectable(component: &Component, behavior: &Behavior) -> bool {
+    match component {
+        Component::Div | Component::HFlex | Component::VFlex => {
+            behavior.drag.is_none()
+                && behavior.dock_commands.is_empty()
+                && !behavior
+                    .on_mouse_down
+                    .iter()
+                    .any(|(button, _)| *button == MouseButton::Left)
+        }
+        Component::Collapsible
+        | Component::Accordion(_)
+        | Component::AccordionItem
+        | Component::AccordionPanel
+        | Component::Table(_)
+        | Component::TableHeader(_)
+        | Component::TableBody(_)
+        | Component::TableRow(..)
+        | Component::TableHead(..)
+        | Component::TableCell(..)
+        | Component::TableCaption(_)
+        | Component::Resizable(..)
+        | Component::ResizablePanel
+        | Component::DockArea(_)
+        | Component::DockContent
+        | Component::Popover(_)
+        | Component::HoverCard(_)
+        | Component::Popup(_) => true,
+        _ => false,
+    }
+}
+
+/// HERDR: true when the press behind a mouse click dragged out a text
+/// selection: that press was a selection, and the element it ended on must not
+/// also hear a click. A press that barely moved still clicks, and the stray
+/// character or word its jitter selected is cleared, so a click looks and acts
+/// as it did before text could be selected.
+pub(crate) fn click_was_a_selection(
+    event: &gpui::ClickEvent,
+    window: &mut Window,
+    cx: &mut App,
+) -> bool {
+    /// How far a press may wander and still be a click, in either direction.
+    const CLICK_SLOP: f32 = 4.;
+    let gpui::ClickEvent::Mouse(click) = event else {
+        return false;
+    };
+    if !gpui_base::TextSelection::has_selection(window, cx) {
+        return false;
+    }
+    let moved = click.up.position - click.down.position;
+    if moved.x.abs() > gpui::px(CLICK_SLOP) || moved.y.abs() > gpui::px(CLICK_SLOP) {
+        return true;
+    }
+    gpui_base::TextSelection::clear(window, cx);
+    false
+}
