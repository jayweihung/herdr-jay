 const pad2 = (n) => String(n).padStart(2, "0");
 const laneColors = (t) => [t.ansi4, t.ansi2, t.ansi5, t.ansi3, t.ansi6, t.ansi1, t.ansi12, t.ansi10, t.ansi13, t.ansi11, t.ansi14, t.ansi9];
+// jay: copying. A commit's message is selectable text (drag over it, then Cmd/Ctrl+C); a right-click on a single
+// value (hash, author, date, file path, diff line, branch, error) copies it and says 已複製. Left clicks are untouched.
+const esc = (s) => String(s ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
+const textBlock = (id, text) => (String(text ?? "") ? TextView.html(id, `<p>${String(text).split("\n").map(esc).join("<br>")}</p>`).selectable(true) : "");
+const copyText = (value, cx) => {
+  const text = String(value ?? "");
+  if (!text) return false;
+  cx.stop_propagation();
+  cx.write_to_clipboard(text);
+  notify({ title: "已複製", body: text.length > 120 ? `${text.slice(0, 120)}…` : text, level: "success", timeout: 1500 });
+  return true;
+};
+// on_mouse_down("right", copyOn(value))
+const copyOn = (value) => (_e, cx) => { copyText(value, cx); };
 const isRefChange = (p) => /\/(HEAD|packed-refs)$|\/refs\//.test(p);
 const inGitDir = (p) => p.includes("/.git/") || p.endsWith("/.git");
 
