Subject: [PATCH 14/35] fix: the agents menu's sends run as typed (no --if
 idle, closed once sent), say when sent, show short reasons and the row's name

---
 defaults/mods/agents/main.js | 46 ++++++++++++++++++++----------------
 1 file changed, 25 insertions(+), 21 deletions(-)

diff --git a/defaults/mods/agents/main.js b/defaults/mods/agents/main.js
index 79982f6..555944d 100644
--- a/defaults/mods/agents/main.js
+++ b/defaults/mods/agents/main.js
@@ -101,20 +101,20 @@ const TOOLS = { "claude-code": "claude", claude: "claude", codex: "codex", omp:
 // each tool's own commands: compact, and a new conversation
 const TOOL_CMDS = { claude: { compact: "/compact", clear: "/clear" }, codex: { compact: "/compact", clear: "/new" }, omp: { compact: "/compact", clear: "/new" } };
 export const toolOf = (a) => TOOLS[String(a?.app ?? "").toLowerCase()] ?? TOOLS[String(a?.program?.key ?? "").toLowerCase()] ?? null;
-// hc send: only to an agent that waits for you (idle: --if idle, so hc refuses if it started meanwhile; done: it finished
-// while nobody looked)
-export const sendTo = (a, text) => (a.status === "idle" ? ["send", "--if", "idle", a.address, text] : ["send", a.address, text]);
+// hc send, plainly: the menu offers it only while the agent waits, and `--if idle` would refuse one the core
+// still calls done (the list shows a done agent you've looked at as idle)
+export const sendTo = (a, text) => ["send", a.address, text];
 // the items: [label, what, off (why it can't be picked now, or ""), ask (picked once more to do it)]
 export function menuItems(a, more = {}, now = Date.now()) {
   if (!a) return [];
   const cmds = TOOL_CMDS[toolOf(a)], waits = a.status === "idle" || a.status === "done";
-  const busy = a.status === "working" ? "它在工作：等它停下來" : a.status === "blocked" ? "它在等你回答" : "";
-  const typed = (label, what, ask = "") => [label, what, !cmds ? "這個 agent 不支援" : waits ? "" : busy || "它還沒準備好", ask];
+  const busy = a.status === "working" ? "工作中" : a.status === "blocked" ? "等你回答" : "";
+  const typed = (label, what, ask = "") => [label, what, !cmds ? "不支援" : waits ? "" : busy || "還沒好", ask];
   const list = [
     typed("壓縮", "compact"),
     typed("清空重來", "clear", "再按一次：清空這個對話，重新開始"),
-    ["停下來", "stop", a.status === "working" ? "" : "它沒在工作", ""],
-    ["繼續", "continue", waits ? "" : busy || "它還沒準備好", ""],
+    ["停下來", "stop", a.status === "working" ? "" : "沒在工作", ""],
+    ["繼續", "continue", waits ? "" : busy || "還沒好", ""],
   ];
   const extra = Object.entries(more ?? {}).filter(([, m]) => m && now - (m.at ?? 0) < MENU_TTL && Array.isArray(m.items))
     .flatMap(([mod, m]) => m.items.filter((i) => i?.id && i?.label).map((i) => [String(i.label), `mod:${mod}:${i.id}`, "", ""]));
@@ -227,6 +227,8 @@ export default class Agents extends View {
   }
 
   agentMenu(t) {
+    // the name its row shows (the list passes it), so the menu and its notice read the same
+    const nameOf = (a) => props().name || a.title || a.program?.name || a.address;
     const a = agents().find((x) => x.address === props().agentMenu);
     const list = menuItems(a, shared("agents.menu"));
     if (!a) return v_flex().w_full().p(10).bg(t.popover).text_size(12.8).text_color(t.dim).child("這個 agent 已經不在了");
@@ -234,8 +236,10 @@ export default class Agents extends View {
       const it = list[i];
       if (!it || it[2]) return;
       if (it[3] && this.asking !== it[1]) { this.asking = it[1]; this.at = i; cx.notify(); return; }
-      closeOverlay(props().overlay);
-      this.act(a, it[1]);
+      // hc runs in this popup: closing it first would drop the send, so close once it's done
+      const id = props().overlay, sent = this.act(a, it[1], nameOf(a));
+      if (sent) sent.finally(() => closeOverlay(id));
+      else closeOverlay(id);
     };
     return v_flex()
       .id("agent-menu")
@@ -254,7 +258,7 @@ export default class Agents extends View {
         this.asking = null;
