+
+/// Windows: wry waits for a new WebView2 page by pumping the thread's
+/// messages, which in a draw would run GPUI's tasks while the app is busy (a
+/// panic). So a task makes it after the frame, once; a failure shows on the
+/// element until its props change.
+#[cfg(windows)]
+fn create_later(key: &Key, spec: Spec, rules: &Rc<Rules>, window: &mut Window, cx: &mut App) -> Result<(), String> {
+    let known = CREATING.with_borrow_mut(|c| match c.get(key) {
+        Some(None) => Some(Ok(())),
+        Some(Some((tried, e))) if *tried == spec => Some(Err(e.clone())),
+        _ => {
+            c.insert(key.clone(), None);
+            None
+        }
+    });
+    if let Some(known) = known {
+        return known;
+    }
+    let (key, rules, here) = (key.clone(), rules.clone(), imp::window_of(window));
+    window
+        .spawn(cx, async move |cx| {
+            match imp::Page::new(here, &key, &spec, rules) {
+                Ok(page) => {
+                    page.load(&spec.url);
+                    CREATING.with_borrow_mut(|c| c.remove(&key));
+                    with_views_mut(|v| v.insert(key, View { page, spec, rect: None, painter: 0, zoom: 0.0 }));
+                }
+                Err(e) => {
+                    CREATING.with_borrow_mut(|c| c.insert(key, Some((spec, e))));
+                }
+            }
+            let _ = cx.update(|window, _| window.refresh());
+        })
+        .detach();
     Ok(())
 }
 
