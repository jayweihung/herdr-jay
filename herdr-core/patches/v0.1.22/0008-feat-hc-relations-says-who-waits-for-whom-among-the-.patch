+    let s = session();
+    let a = run(&s, &["sh", "-c", &script(&s, "r state=working; w sent; r state=idle; sleep 100")]);
+    let b = run(&s, &["sh", "-c", &script(&s, "r state=working; sleep 100")]);
+    let state = |t: &str| get(&s, t)["status"]["state"].as_str().map(String::from);
+    wait_until("both working", || state(&a).as_deref() == Some("working") && state(&b).as_deref() == Some("working"));
+    let out = s.cmd().env("HC_TERMINAL_ID", &a).args(["--json", "send", &b, "review x.rs"]).output().unwrap();
+    assert!(out.status.success(), "{}", String::from_utf8_lossy(&out.stderr));
+    touch(&s, "sent");
+    wait_until("a stopped", || state(&a).as_deref() == Some("idle"));
+
+    let r = s.json(&["relations"]);
+    let w = &r["waits"][0];
+    assert_eq!((w["from"].as_str(), w["to"].as_str()), (Some(a.as_str()), Some(b.as_str())), "{r}");
+    assert_eq!((w["state"].as_str(), w["text"].as_str()), (Some("working"), Some("review x.rs")), "b is on it");
+    assert_eq!(r["nodes"].as_array().map(Vec::len), Some(2));
+    let words: Vec<_> = get(&s, &a)["history"].as_array().unwrap().iter().map(|w| w["state"].clone()).collect();
+    assert_eq!(words, ["working", "idle"]);
+}
