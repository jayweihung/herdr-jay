+}
+
+thread_local! {
+    /// Set while this frame paints a target that refuses the drag under the
+    /// pointer; the chip, painted last, reads and clears it.
+    static REFUSED_UNDER_POINTER: Cell<bool> = const { Cell::new(false) };
+    /// What the chip showed this frame: GPUI works out drag styles while
+    /// painting, after the chip was laid out, so the chip catches up a frame
+    /// later.
+    static CHIP_REFUSED: Cell<bool> = const { Cell::new(false) };
+}
+
+/// How a target that refuses the drag looks while it is under the pointer.
+pub(crate) fn refused_style() -> StyleRefinement {
+    StyleRefinement {
+        opacity: Some(0.4),
+        ..StyleRefinement::default()
+    }
+}
+
+/// The `drag_over` style of a target with an optional `drop_key`: refused
+/// (dimmed, and the chip and pointer told) or its own `over`.
+pub(crate) fn over_style(
+    style: StyleRefinement,
+    drag: &ScriptDrag,
+    key: Option<&SharedString>,
+    over: Option<&StyleRefinement>,
+) -> StyleRefinement {
+    let mut style = style;
+    if key.is_some_and(|key| drag.refused_by(key)) {
+        REFUSED_UNDER_POINTER.set(true);
+        style.refine(&refused_style());
+    } else if let Some(over) = over {
+        style.refine(over);
+    }
+    style
 }
 
 /// The chip under the pointer while dragging.
 struct Chip {
     label: SharedString,
+    refused_label: SharedString,
     /// Where the press was in the source element: GPUI draws the drag view
     /// that far up and left of the pointer, so the chip is padded back past it.
     offset: Point<Pixels>,
