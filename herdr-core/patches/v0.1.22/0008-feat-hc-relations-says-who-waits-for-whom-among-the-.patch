 /// How a machine's line is: "connected", "unreachable since 14:02 (why)", ...
+/// `hc relations` for a person: one line per wait, chain, clash, block and idle one.
+pub(super) fn relations(r: &Value) -> String {
+    let list = |k: &str| r[k].as_array().cloned().unwrap_or_default();
+    let s = |v: &Value| v.as_str().unwrap_or_default().to_string();
+    let path = |v: &Value| v.as_array().into_iter().flatten().map(s).collect::<Vec<_>>();
+    let min = |v: &Value| v.as_u64().unwrap_or(0) / 60_000;
+    let mut lines = Vec::new();
+    lines.extend(
+        list("waits")
+            .iter()
+            .map(|w| format!("{} waits for {} ({}): {}", s(&w["from"]), s(&w["to"]), s(&w["state"]), s(&w["text"]))),
+    );
+    lines.extend(list("chains").iter().map(|c| format!("stuck ({}): {}", s(&c["why"]), path(&c["path"]).join(" -> "))));
+    lines.extend(
+        list("clashes").iter().map(|c| format!("one folder: {} in {}", path(&c["nodes"]).join(", "), s(&c["dir"]))),
+    );
+    lines.extend(list("blocked").iter().map(|b| {
+        let kind = Some(s(&b["kind"])).filter(|k| !k.is_empty()).unwrap_or("you".into());
+        format!("{} waits for {kind} ({} min): {}", s(&b["address"]), min(&b["for"]), s(&b["ask"]))
+    }));
+    lines.extend(
+        list("idle").iter().map(|i| format!("{} idle {} min, nobody waits for it", s(&i["address"]), min(&i["for"]))),
+    );
+    if lines.is_empty() {
+        return format!("{} agents, nobody waits", list("nodes").len());
+    }
+    lines.join("\n")
+}
