 );
 
+/// A page's alert / confirm / prompt as a macOS dialog: its text, the page's host
+/// under it, OK (and Cancel); prompt's text field below. True when OK was pressed.
+fn page_dialog(mtm: MainThreadMarker, text: &NSString, frame: &WKFrameInfo, cancel: bool, field: Option<&NSTextField>) -> bool {
+    let alert = NSAlert::new(mtm);
+    alert.setMessageText(text);
+    let host = unsafe { frame.securityOrigin().host() };
+    alert.setInformativeText(&host);
+    alert.addButtonWithTitle(ns_string!("好"));
+    if cancel {
+        alert.addButtonWithTitle(ns_string!("取消"));
+    }
+    if let Some(f) = field {
+        alert.setAccessoryView(Some(f));
+        alert.window().setInitialFirstResponder(Some(f));
+    }
+    alert.runModal() == NSAlertFirstButtonReturn
+}
