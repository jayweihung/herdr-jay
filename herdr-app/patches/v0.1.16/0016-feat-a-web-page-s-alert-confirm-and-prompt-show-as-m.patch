+        /// alert(): a dialog with OK.
+        #[unsafe(method(webView:runJavaScriptAlertPanelWithMessage:initiatedByFrame:completionHandler:))]
+        fn alert(&self, _web: &WKWebView, text: &NSString, frame: &WKFrameInfo, handler: &block2::DynBlock<dyn Fn()>) {
+            page_dialog(self.mtm(), text, frame, false, None);
+            handler.call(());
+        }
+
+        /// confirm(): OK or Cancel.
+        #[unsafe(method(webView:runJavaScriptConfirmPanelWithMessage:initiatedByFrame:completionHandler:))]
+        fn confirm(&self, _web: &WKWebView, text: &NSString, frame: &WKFrameInfo, handler: &block2::DynBlock<dyn Fn(objc2::runtime::Bool)>) {
+            let ok = page_dialog(self.mtm(), text, frame, true, None);
+            handler.call((objc2::runtime::Bool::new(ok),));
+        }
+
+        /// prompt(): a line of text, or null on Cancel.
+        #[unsafe(method(webView:runJavaScriptTextInputPanelWithPrompt:defaultText:initiatedByFrame:completionHandler:))]
+        fn prompt(&self, _web: &WKWebView, text: &NSString, default: Option<&NSString>, frame: &WKFrameInfo, handler: &block2::DynBlock<dyn Fn(*mut NSString)>) {
+            let mtm = self.mtm();
+            let field = NSTextField::textFieldWithString(default.unwrap_or(ns_string!("")), mtm);
+            field.setFrame(NSRect::new(NSPoint::new(0.0, 0.0), NSSize::new(280.0, 24.0)));
+            if page_dialog(mtm, text, frame, true, Some(&field)) {
+                handler.call((Retained::as_ptr(&field.stringValue()).cast_mut(),));
+            } else {
+                handler.call((std::ptr::null_mut(),));
+            }
+        }
+
