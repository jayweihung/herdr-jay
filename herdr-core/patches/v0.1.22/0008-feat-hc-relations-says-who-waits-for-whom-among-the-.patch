+/// A new word in its history: older than a day, or past the limit, goes.
+pub fn remember(t: &mut Terminal, state: String, at_ms: u64) {
+    t.history.retain(|w| at_ms.saturating_sub(w.at_ms) < HISTORY_MS);
+    t.history.push(Word { state, at_ms });
+    let over = t.history.len().saturating_sub(MAX_HISTORY);
+    t.history.drain(..over);
