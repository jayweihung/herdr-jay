+      if (ctx.branches.includes(branch)) { if (branch !== ctx.current) openDialog({ type: "checkout", name: branch }, ctx); }  // jay: ask first
       else openDialog({ type: "checkoutRemote", name: part.name, remote: part.name.slice(0, part.name.indexOf("/")), branch }, ctx);
     }
   }
