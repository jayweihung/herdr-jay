From b1a72bbe3d9ead00001d7d7d0447b4c9a643b750 Mon Sep 17 00:00:00 2001
From: jayweihung <3034830+jayweihung@users.noreply.github.com>
Date: Thu, 12 Nov 2026 20:31:48 +0800
Subject: [PATCH] git-graph: ask before every checkout; selectable commit text,
 right-click copies a value
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

jay's changes on top of v0.3.1 (used with herdr-jay's git-toggle button):
- a branch checkout (double-click or menu) asks first, like the other actions
- a commit's message is selectable text; a right-click on a hash, author, date,
  file path, diff line, branch or error copies it and says 已複製
---
 mods/git-graph/git.js   |  2 ++
 mods/git-graph/graph.js | 52 +++++++++++++++++++++++++++--------------
 2 files changed, 37 insertions(+), 17 deletions(-)

diff --git a/mods/git-graph/git.js b/mods/git-graph/git.js
index 1716331..0be2551 100644
--- a/mods/git-graph/git.js
+++ b/mods/git-graph/git.js
@@ -229,6 +229,8 @@ function repoMenu(r, ctx) {
 export function dialogFor(action, ctx) {
   const cur = currentName(ctx), a = action;
   switch (a.type) {
+    // jay: every checkout asks first (upstream ran a local-branch checkout at once, from a double-click or the menu)
+    case "checkout": return { title: "Checkout branch", detail: `Switch ${cur} to ${a.name}? Uncommitted changes come along; git refuses if they would be overwritten.`, confirm: "Checkout" };
     case "checkoutRemote": return { title: "Checkout remote branch", detail: `Create a local branch that tracks ${a.name}, and check it out.`,
       inputs: [{ id: "name", label: "Local branch name", value: a.branch }], confirm: "Checkout" };
     case "checkoutCommit": return { title: "Checkout commit", detail: `Check out commit ${a.short}? You'll be on a detached HEAD: new commits belong to no branch until you create one.`, confirm: "Checkout" };
diff --git a/mods/git-graph/graph.js b/mods/git-graph/graph.js
index 304b1e1..c817d19 100644
--- a/mods/git-graph/graph.js
+++ b/mods/git-graph/graph.js
