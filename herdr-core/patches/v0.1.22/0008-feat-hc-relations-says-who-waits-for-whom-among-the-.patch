+async fn terminal_relations(core: Ctx<'_>, p: RelationsParams) -> Result<crate::relations::Relations, RpcError> {
+    let to = match &p.on {
+        Some(on) => crate::remote::machine_named(core, on)?,
+        None => None,
+    };
+    let terminals = match to {
+        // Its list, addresses as seen here: an older core there works too (without history).
+        Some(m) => crate::remote::forward(core, &m, "terminal.list", json!({})).await?["terminals"]
+            .as_array()
+            .cloned()
+            .unwrap_or_default(),
+        None => terminal_list(core, ListParams { all: false, labels: Vec::new() }).await?.terminals,
+    };
+    Ok(crate::relations::of(&terminals, now_ms()))
+}
