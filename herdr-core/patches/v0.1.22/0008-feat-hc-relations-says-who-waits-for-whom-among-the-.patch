+    fn who_waits_for_whom_chains_to_the_end_and_loops_and_a_reply_ends_the_wait() {
+        // a asked b (b stopped after it: no answer); c asked d (d works on it); e asked f, f asked g, g needs you
+        let agents = "a:idle b:idle c:idle d:working e:idle f:idle g:blocked h:idle";
+        let terms = [
+            json!({"address": "a", "sent": [msg("b", 1000)]}),
+            json!({"address": "b", "status_ms": 9000}),
+            json!({"address": "c", "sent": [msg("d", 1000)]}),
