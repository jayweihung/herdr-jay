+/// What `on_drag(payload, label?, refuse?, refused_label?)` records: the
+/// payload, the label (default: the payload's first line), the application
+/// whose view recorded it (so whoever takes the drop can tell whose drag it
+/// was), the refusing drop keys (one per line) and the chip's text over one
+/// of them (default: the label).
 pub(crate) fn record(args: SmallVec<[Bridged; 2]>) -> Result<SmallVec<[Bridged; 2]>, String> {
+    const USAGE: &str = "on_drag(payload, label?, refuse?, refused_label?)";
     let Some(Bridged::Str(payload)) = args.first() else {
-        return Err("on_drag(payload, label?) expects a string payload".into());
+        return Err(format!("{USAGE} expects a string payload"));
