+    #[test]
+    fn a_new_pane_can_take_less_than_half() {
+        let mut n = Node::container("r", Axis::Row, vec![term("a"), term("b")]);
+        assert!(n.split("a", Axis::Row, term("x"), "s".into()));
+        assert!(n.reshare("a", "x", 0.25));
+        assert_eq!(n.find("a").unwrap().size, Some(Size::Weight { weight: 0.75 }));
+        assert_eq!(n.find("x").unwrap().size, Some(Size::Weight { weight: 0.25 }));
+        assert_eq!(n.find("b").unwrap().size, None);
+        let mut lone = term("a");
+        assert!(lone.split("a", Axis::Row, term("x"), "s".into()));
+        assert!(lone.reshare("a", "x", 0.3));
+        assert_eq!(lone.find("x").unwrap().size, Some(Size::Weight { weight: 0.6 }));
+    }
