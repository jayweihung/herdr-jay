+/// A terminal's own icon (label `herdr.icon`, see icon_ok) in place of its program's: drawn as a picture.
+fn with_icon(mut program: Value, labels: Option<&Value>) -> Value {
+    if let Some(icon) = labels.and_then(|l| l.get("herdr.icon")).and_then(Value::as_str).filter(|p| icon_ok(p)) {
+        program["icon"] = icon.into();
+        program["tint"] = false.into();
+        program["tile"] = Value::Null;
+        program["color"] = Value::Null;
+    }
+    program
+}
+
+/// An icon a terminal may have: an .svg or .png under the app's folder, as a plain relative path
+/// (letters, digits, `.`, `_`, `-` between slashes; no `..`), at most 200 bytes.
+fn icon_ok(p: &str) -> bool {
+    p.len() <= 200
+        && (p.ends_with(".svg") || p.ends_with(".png"))
+        && p.split('/').all(|s| !s.is_empty() && s != "." && s != ".." && s.bytes().all(|b| b.is_ascii_alphanumeric() || b"._-".contains(&b)))
+}
+
 fn program_of(report: &Value, argv: Option<&Value>) -> Value {
     let app = report.get("app").and_then(Value::as_str);
     let argv: Vec<String> = argv.and_then(Value::as_array).into_iter().flatten().filter_map(|a| a.as_str().map(str::to_owned)).collect();
