+const MENU_TTL = 600000;
+const size = (k, n) => (Number.isFinite(n) && n > 0 ? { [k]: n } : {});
+export function modItems(more, s, now = Date.now()) {
+  return Object.entries(more ?? {}).filter(([, m]) => m && now - (m.at ?? 0) < MENU_TTL && Array.isArray(m.items))
+    .flatMap(([mod, m]) => m.items.filter((i) => i?.id && i?.label).map((i) => [String(i.labels?.[s.id] ?? i.label), "mod", {
