+// A row dragged within its space's group (grouped by space): which tab, from which space.
+const MOVE = "agents.move";
+const movePayload = (a) => JSON.stringify({ [MOVE]: a.tab, space: a.space });
+function readMove(p) {
+  try { const j = JSON.parse(String(p ?? "")); return typeof j?.[MOVE] === "string" ? { tab: j[MOVE], space: j.space } : null; } catch { return null; }
+}
+// Where a tab now at position `from` goes to land before the tab at `at` (both 1 = first, counted before it moves).
+export const moveTarget = (from, at) => (from < at ? at - 1 : at);
 
