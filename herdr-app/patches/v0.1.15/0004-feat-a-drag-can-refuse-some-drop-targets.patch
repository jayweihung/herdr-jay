+/// that refuse it and the chip's text over one of those.
 #[derive(Clone, Debug, PartialEq)]
 pub(crate) struct ScriptDrag {
     pub payload: SharedString,
     pub label: SharedString,
     pub source: SharedString,
+    pub refuse: Vec<SharedString>,
+    pub refused_label: SharedString,
+}
+
+impl ScriptDrag {
+    /// From what `record` returned (the `on_drag` op's arguments).
+    pub(crate) fn from_recorded(args: &[Bridged]) -> Option<Self> {
+        let [Bridged::Str(payload), Bridged::Str(label), Bridged::Str(source), rest @ ..] = args
+        else {
+            return None;
+        };
+        let text = |index: usize| match rest.get(index) {
+            Some(Bridged::Str(text)) => text.as_str(),
+            _ => "",
+        };
+        Some(Self {
+            payload: payload.clone().into(),
+            label: label.clone().into(),
+            source: source.clone().into(),
+            refuse: keys(text(0)),
+            refused_label: text(1).to_owned().into(),
+        })
+    }
+
+    /// Whether the target with this `drop_key` refuses the drag.
+    pub(crate) fn refused_by(&self, key: &str) -> bool {
+        self.refuse.iter().any(|refused| refused.as_ref() == key)
+    }
+}
+
+/// The keys in `on_drag`'s `refuse`: one per line, blank lines left out.
+fn keys(text: &str) -> Vec<SharedString> {
+    text.lines()
+        .map(str::trim)
+        .filter(|key| !key.is_empty())
+        .map(|key| SharedString::from(key.to_owned()))
+        .collect()
 }
 
-/// What `on_drag(payload, label?)` records: the payload, the label (default:
