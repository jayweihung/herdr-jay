+            json!({"address": "e", "sent": [msg("f", 1000)]}),
+            json!({"address": "f", "sent": [msg("g", 2000)], "status_ms": 2100}),
+            json!({"address": "g", "status_ms": 5000}),
+            json!({"address": "h", "sent": [msg("a", 900)]}), // h asked a before a asked b
+        ];
+        let at = |terms: &[Value], agents: &str, now: u64| of(&records(agents, terms), now);
+        let g = at(&terms, agents, 60000);
