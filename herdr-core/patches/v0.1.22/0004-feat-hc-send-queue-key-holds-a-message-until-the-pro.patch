diff --git a/crates/herdr-core/src/queue.rs b/crates/herdr-core/src/queue.rs
new file mode 100644
index 0000000..43f9bd4
--- /dev/null
+++ b/crates/herdr-core/src/queue.rs
@@ -0,0 +1,83 @@
+//! Sends that wait until the program stops working (`hc send --queue --key k`):
+//! one per key, typed in when it is no longer working or blocked, then kept as
+//! `sent` until that turn ends, so every panel can show "compacting" the same way.
+
+use crate::runtime::{Core, now_ms};
+use crate::terminals::Queued;
+use std::sync::Arc;
+use std::time::Duration;
+
+/// A sent entry no turn ever ended for (a program that never reports) goes after this.
+const SENT_FOR: u64 = 10 * 60 * 1000;
+
+impl Core {
+    /// Queue `text` for `id` under `key`, replacing that key's earlier entry.
+    pub fn queue_send(&self, id: u32, key: &str, text: &str) {
+        let mut st = self.lock();
+        let Some(t) = st.reg.terminals.get_mut(&id) else { return };
+        t.queued.retain(|q| q.key != key);
+        t.queued.push(Queued { key: key.into(), text: text.into(), at_ms: now_ms(), state: "queued".into(), turn: None });
+        self.queued_changed(&mut st, id);
+        drop(st);
+        self.changed.notify_waiters();
+    }
+
+    fn queued_changed(&self, st: &mut crate::runtime::State, id: u32) {
+        let Some(t) = st.reg.terminals.get(&id) else { return };
+        let queued = serde_json::to_value(&t.queued).unwrap_or_default();
+        self.save(st);
+        self.emit(st, "queued", id, serde_json::json!({ "queued": queued }));
+    }
+
+    /// Forever: on every change, end finished entries and type in what is due.
+    pub async fn send_queued(self: Arc<Self>) {
+        loop {
+            let changed = self.changed.notified();
+            for (id, key, text) in self.due() {
+                // Typed like any send (waits for a person's draft); a refusal leaves it queued for the next change.
+                if let Ok(sent) = self.send(id, &text, false, None).await {
+                    let mut st = self.lock();
+                    let Some(t) = st.reg.terminals.get_mut(&id) else { continue };
+                    if sent.status.is_none() {
+                        t.queued.retain(|q| q.key != key); // it never reports a turn ending: done once typed
+                    } else if let Some(q) = t.queued.iter_mut().find(|q| q.key == key) {
+                        q.state = "sent".into();
+                        q.turn = Some(sent.turn);
+                        q.at_ms = now_ms();
+                    }
+                    self.queued_changed(&mut st, id);
+                }
+            }
+            let _ = tokio::time::timeout(Duration::from_secs(15), changed).await;
+        }
+    }
+
+    /// Entries to type in now, after dropping sent ones whose turn ended.
+    fn due(&self) -> Vec<(u32, String, String)> {
+        let mut st = self.lock();
+        let now = now_ms();
+        let mut due = Vec::new();
+        let mut touched = Vec::new();
+        for (id, t) in st.reg.terminals.iter_mut().filter(|(_, t)| !t.queued.is_empty()) {
+            let word = t.status.as_ref().map(|s| s.state.as_str());
+            let busy = matches!(word, Some("working" | "blocked"));
+            let before = t.queued.len();
+            let turn = t.turn;
+            t.queued.retain(|q| {
+                q.state != "sent" || (q.turn.is_some_and(|n| turn <= n) || busy) && now.saturating_sub(q.at_ms) < SENT_FOR
+            });
+            if t.queued.len() != before {
+                touched.push(*id);
+            }
+            if t.state == "live" && !busy && !t.queued.iter().any(|q| q.state == "sent") {
+                if let Some(q) = t.queued.iter().find(|q| q.state == "queued") {
+                    due.push((*id, q.key.clone(), q.text.clone()));
+                }
+            }
+        }
+        for id in touched {
+            self.queued_changed(&mut st, id);
+        }
+        due
+    }
+}
