+/// What `on_drag(payload, label?)` records: the payload, the label (default:
+/// the payload's first line) and the application whose view recorded it, so
+/// whoever takes the drop can tell whose drag it was.
+pub(crate) fn record(args: SmallVec<[Bridged; 2]>) -> Result<SmallVec<[Bridged; 2]>, String> {
+    let Some(Bridged::Str(payload)) = args.first() else {
+        return Err("on_drag(payload, label?) expects a string payload".into());
+    };
+    if payload.len() > MAX_PAYLOAD {
+        return Err(format!("on_drag payload is at most {MAX_PAYLOAD} bytes"));
+    }
+    let label = match args.get(1) {
+        None | Some(Bridged::Nil) => payload.lines().next().unwrap_or("").to_owned(),
+        Some(Bridged::Str(label)) => label.clone(),
+        Some(_) => return Err("on_drag(payload, label?) expects a string label".into()),
+    };
+    let application = scope::policy().application().to_owned();
+    Ok(smallvec![Bridged::Str(payload.clone()), Bridged::Str(label), Bridged::Str(application)])
+}
