index 0000000..f9441f2
--- /dev/null
+++ b/vendor/gpui-kit/crates/shell/src/drag.rs
@@ -0,0 +1,84 @@
+//! HERDR: drags a script starts with `on_drag(payload, label)`.
+//!
+//! GPUI's own drag, kept inside the window (no external payload, so it is never
+//! handed to the system): any view in the window takes it with `on_drag_drop`
+//! and styles itself with `drag_over` while one hovers.
+
+use std::rc::Rc;
+
+use gpui::{
+    AppContext as _, Context, IntoElement, ParentElement as _, Pixels,
+    Point, Render, SharedString, StatefulInteractiveElement, Styled as _, Window, div,
+};
+use gpui_base::Theme;
+
+use crate::{ShellRuntime, spec::CallbackId, value::scaled_px};
+
+/// The longest payload `on_drag` takes, in bytes: a drag says what, not the data.
+pub(crate) const MAX_PAYLOAD: usize = 8 * 1024;
+
+/// What a script drag carries: its payload, the chip's text, and the
+/// application (`Policy::application`) whose view started it.
+#[derive(Clone, Debug, PartialEq)]
+pub(crate) struct ScriptDrag {
+    pub payload: SharedString,
+    pub label: SharedString,
+    pub source: SharedString,
+}
+
+/// The chip under the pointer while dragging.
+struct Chip {
+    label: SharedString,
+    /// Where the press was in the source element: GPUI draws the drag view
+    /// that far up and left of the pointer, so the chip is padded back past it.
+    offset: Point<Pixels>,
+}
+
+impl Render for Chip {
+    fn render(&mut self, _: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
+        let colors = Theme::global(cx).tokens.colors;
+        div()
+            .pl(self.offset.x + scaled_px(14.))
+            .pt(self.offset.y + scaled_px(10.))
+            .child(
+                div()
+                    .max_w(scaled_px(280.))
+                    .px(scaled_px(8.))
+                    .py(scaled_px(4.))
+                    .rounded(scaled_px(6.))
+                    .border_1()
+                    .border_color(colors.border)
+                    .bg(colors.surface)
+                    .text_color(colors.foreground)
+                    .text_size(scaled_px(12.))
+                    .shadow_md()
+                    .truncate()
+                    .child(self.label.clone()),
+            )
+    }
+}
+
+/// `on_drag` and `on_drag_drop` on one element.
+pub(crate) fn with_drag<E: StatefulInteractiveElement>(
+    element: E,
+    drag: Option<&ScriptDrag>,
+    on_drop: Option<CallbackId>,
+    runtime: &Rc<ShellRuntime>,
+) -> E {
+    let mut element = element;
+    if let Some(drag) = drag {
+        element = element.on_drag(drag.clone(), |drag, offset, _, cx| {
+            let label = drag.label.clone();
+            cx.new(|_| Chip { label, offset })
+        });
+    }
+    if let Some(callback) = on_drop {
+        let runtime = Rc::downgrade(runtime);
+        element = element.on_drop(move |drag: &ScriptDrag, window, cx| {
+            if let Some(runtime) = runtime.upgrade() {
+                runtime.dispatch_script_drop(callback, drag, window, cx);
+            }
+        });
+    }
+    element
+}
