+
+test("agents keep folded groups and agent trees; a gone agent's fold goes", async () => {
+  const { view, data } = await harness("agents", { folded: '["sec-1","t1","t9"]' });
+  expect([...view.folded]).toEqual(["sec-1", "t1", "t9"]);
+  view.keepFolded();
+  expect(JSON.parse(data.get("folded")!)).toEqual(["sec-1", "t1"]);
+  const { view: fresh } = await harness("agents", { folded: "{{{not json" });
+  expect([...fresh.folded]).toEqual([]);
+});
+
+test("files keep open folders and the previewed file per folder", async () => {
+  const { view, data } = await harness("files", { saved: '{"a":{"folders":["src",3],"file":"src/x.js"},"b":"old shape"}' });
+  expect(view.saved.get("a")).toEqual({ folders: ["src"], file: "src/x.js" });
+  expect(view.saved.get("b")).toEqual({ folders: [], file: null });
+  view.context = { key: "c" }; view.folders = new Set(["docs"]); view.file = "docs/a.md";
+  view.keep();
+  expect(JSON.parse(data.get("saved")!).c).toEqual({ folders: ["docs"], file: "docs/a.md" });
+  const { view: broken } = await harness("files", { saved: "{{{not json" });
+  expect(broken.saved.size).toBe(0);
+});
+
+test("changes keep the picked file, a closed diff and the unsent message per folder", async () => {
+  const here = JSON.stringify({ on: null });
+  const { view, data } = await harness("changes", { kept: JSON.stringify({ [here]: { open: "a.txt", closed: false, message: "wip" } }) });
+  expect(view.open).toBe("a.txt");
+  expect(view.message).toBe("wip");
+  expect(view.input.value).toBe("wip");
+  view.message = ""; view.open = null; view.closed = true;
+  view.keep();
+  expect(JSON.parse(data.get("kept")!)[here]).toEqual({ open: null, closed: true, message: "" });
+  view.closed = false; view.keep();
+  expect(JSON.parse(data.get("kept")!)[here]).toBeUndefined();
+  const { view: broken } = await harness("changes", { kept: "[]" });
+  expect(broken.open).toBe(null);
+});
