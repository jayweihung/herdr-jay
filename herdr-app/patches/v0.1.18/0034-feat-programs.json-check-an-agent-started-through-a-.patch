+        // started through a launcher: installed when `check` is, whatever `run` starts with
+        let snapshot = vec![
+            json!({"key": "claude", "run": ["printf", "x"], "check": "herdr_issue57_not_installed"}),
+            json!({"key": "codex", "run": ["herdr_issue57_launcher"], "check": "printf"}),
+        ];
+        let launched = std::thread::spawn(move || known_agents(None, snapshot)).join().unwrap().unwrap();
+        assert_eq!(launched[0]["installed"], false);
+        assert_eq!(launched[1]["installed"], true);
     }
 
