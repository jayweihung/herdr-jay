@@ -0,0 +1,643 @@
+//! The `web` mod element: a real web page (the system's web view: WKWebView on
+//! macOS, through wry) placed where a mod draws `web.new(id, { src })`.
+//!
+//! A page is a native view above GPUI's drawing, so the app decides where and
+//! when it shows: each element records the part of it that is visible (its
+//! bounds clipped to its content mask) when painted, and once per frame, after
+//! everything else is painted, `frame_end` moves every page there. A page
+//! hides while its copy isn't on screen, while its element isn't drawn, and
+//! while something Herdr draws may be above it (a dialog, popup or menu, a
+//! movable window over it, a drag); it goes when its copy goes. Same id on the
+//! next render keeps the same page.
+//!
+//! The approach (frames taken at paint time and applied once at the end of the
+//! frame, hidden with their copy or under an overlay, disposed with the copy,
+//! a click outside every page handing the keyboard back to GPUI) is ported from
+//! herdr-universal-preview's native views for mods,
+//! https://github.com/obqyuxi/herdr-universal-preview (Apache-2.0; see
+//! THIRD-PARTY-NOTICES), here on wry instead of its own objc2 views.
+//!
+//! What a page may show is the mod's to say, in its mod.json, not in props an
+//! agent can change: `"web": { "allow": ["https://www.example.org"] }`. The
+//! top level of a page stays on those origins (or `file://` inside the mod's
+//! own folder); other links, redirects and windows go to the system browser.
+
+// Elsewhere pages never open, so their callbacks go unused.
+#![cfg_attr(not(target_os = "macos"), allow(dead_code))]
+
+use gpui::{
+    AnyElement, App, Bounds, Element, ElementId, FocusHandle, GlobalElementId, InspectorElementId, IntoElement, LayoutId, ParentElement, Pixels, Position, Style,
+    Styled, Window, canvas, div, px, relative,
+};
+use serde_json::{Value, json};
+use std::cell::{Cell, RefCell};
+use std::collections::{HashMap, HashSet};
+use std::path::PathBuf;
+use std::rc::Rc;
+
+#[cfg(target_os = "macos")]
+mod macos;
+#[cfg(target_os = "macos")]
+use macos as imp;
+
+/// Windows (WebView2, also through wry) and Linux: not yet.
+#[cfg(not(target_os = "macos"))]
+mod imp {
+    use super::{Action, Bounds, Key, Pixels, Rules, Spec, Window};
+    use std::rc::Rc;
+
+    pub struct Page;
+
+    impl Page {
+        pub fn new(_: &mut Window, _: &Key, _: &Spec, _: Rc<Rules>) -> Result<Page, String> {
+            Err("web pages need macOS for now".into())
+        }
+        pub fn load(&self, _: &url::Url) {}
+        pub fn place(&mut self, _: Option<Bounds<Pixels>>) {}
+        pub fn zoom(&mut self, _: f64) {}
+        pub fn act(&self, _: Action) {}
+        pub fn has_keys(&self) -> bool {
+            false
+        }
+        pub fn give_back_keys(&self) {}
+        pub fn window(&self) -> usize {
+            0
+        }
+    }
+
+    pub fn window_of(_: &Window) -> usize {
+        0
+    }
+}
+
+/// A page: the mod copy that shows it and the id the mod gave it.
+#[derive(Clone, Debug, PartialEq, Eq, Hash)]
+pub struct Key {
+    pub copy: u64,
+    pub id: String,
+}
+
+/// What a mod's mod.json lets its pages show.
+#[derive(Debug, Default)]
+pub struct Rules {
+    /// The mod's folder name (`frame-` mods included), for data stores.
+    pub name: String,
+    /// Origins (scheme, host, port) a page's top level may show.
+    allow: Vec<(String, String, u16)>,
+    /// The mod's own folder, canonical: the only place file:// pages come from.
+    pub folder: Option<PathBuf>,
+    /// What's wrong in mod.json's "web", shown on the element.
+    pub problem: Option<String>,
+}
+
+/// Where a top-level navigation goes.
+#[derive(Debug, PartialEq, Eq)]
+pub enum Nav {
+    Allow,
+    /// Not here: the system browser (or mail app) opens it.
+    Outside,
+    /// Nowhere (a `javascript:` or `data:` page, a file outside the mod).
+    Block,
+}
+
+fn origin(u: &url::Url) -> Option<(String, String, u16)> {
+    Some((u.scheme().to_owned(), u.host_str()?.to_ascii_lowercase(), u.port_or_known_default()?))
+}
+
+impl Rules {
+    /// Reads `"web": { "allow": [...] }` from the mod's mod.json.
+    pub fn for_mod(name: &str) -> Rules {
+        if name.is_empty() {
+            return Rules::default();
+        }
+        let dir = match name.strip_prefix("frame-") {
+            Some(rest) => crate::mods::frame_dir().join(rest),
+            None => crate::mods::mods_dir().join(name),
+        };
+        let meta: Value = std::fs::read_to_string(dir.join("mod.json")).ok().and_then(|s| serde_json::from_str(&s).ok()).unwrap_or_default();
+        Rules::parse(name, &meta, std::fs::canonicalize(&dir).ok())
+    }
+
+    pub fn parse(name: &str, meta: &Value, folder: Option<PathBuf>) -> Rules {
+        let mut rules = Rules { name: name.to_owned(), folder, ..Rules::default() };
+        let Some(list) = meta.get("web").and_then(|w| w.get("allow")) else { return rules };
+        let mut bad = Vec::new();
+        for entry in list.as_array().into_iter().flatten() {
+            // Exactly an origin: https, a host, maybe a port, nothing after.
+            let parsed = entry.as_str().and_then(|s| url::Url::parse(s).ok()).filter(|u| {
+                u.scheme() == "https" && u.username().is_empty() && u.password().is_none() && u.path() == "/" && u.query().is_none() && u.fragment().is_none()
+            });
+            match parsed.as_ref().and_then(origin) {
+                Some(o) => rules.allow.push(o),
+                None => bad.push(entry.to_string()),
+            }
+        }
+        if !list.is_array() {
+            bad.push(list.to_string());
+        }
+        if !bad.is_empty() {
+            rules.problem = Some(format!("mod.json web.allow takes https origins like \"https://example.com\", not {}", bad.join(", ")));
+        }
+        rules
+    }
+
+    /// Where a top-level navigation to `url` goes.
+    pub fn decide(&self, url: &str) -> Nav {
+        let Ok(u) = url::Url::parse(url) else { return Nav::Block };
+        match u.scheme() {
+            "about" if matches!(u.path(), "blank" | "srcdoc") => Nav::Allow,
+            "https" | "http" if origin(&u).is_some_and(|o| self.allow.contains(&o)) => Nav::Allow,
+            "https" | "http" | "mailto" | "tel" => Nav::Outside,
+            "file" if self.inside(&u) => Nav::Allow,
+            _ => Nav::Block,
+        }
+    }
+
+    /// A file:// URL naming a file in this mod's folder (links resolved).
+    fn inside(&self, u: &url::Url) -> bool {
+        let (Some(folder), Ok(path)) = (&self.folder, u.to_file_path()) else { return false };
+        std::fs::canonicalize(path).is_ok_and(|p| p.starts_with(folder))
+    }
+}
+
+/// A web element's props, checked.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Spec {
+    /// `src` as the mod wrote it: the same value never loads again.
+    pub src: String,
+    pub url: url::Url,
+    pub persist: bool,
+    pub zoom: f64,
+}
+
+impl Spec {
+    pub fn parse(props: &Value, rules: &Rules) -> Result<Spec, String> {
+        let src = props.get("src").and_then(Value::as_str).ok_or("web needs { src: \"https://…\" }")?;
+        let url = url::Url::parse(src).map_err(|e| format!("src {src:?}: {e}"))?;
+        match (url.scheme(), rules.decide(url.as_str())) {
+            ("https" | "file", Nav::Allow) => {}
+            ("https", _) => {
+                return Err(format!("{} is not in mod.json's \"web\": {{ \"allow\": [...] }}", url.origin().ascii_serialization()));
+            }
+            ("file", _) => return Err(format!("{src} is not a file in this mod's folder")),
+            (other, _) => return Err(format!("src must be https:// or file://, not {other}:")),
+        }
+        let persist = match props.get("persist") {
+            None | Some(Value::Null) => false,
+            Some(Value::Bool(b)) => *b,
+            Some(_) => return Err("persist is true or false".into()),
+        };
+        let zoom = match props.get("zoom") {
+            None | Some(Value::Null) => 1.0,
+            Some(z) => z.as_f64().filter(|z| (0.25..=5.0).contains(z)).ok_or("zoom is a number from 0.25 to 5")?,
+        };
+        Ok(Spec { src: src.to_owned(), url, persist, zoom })
+    }
+}
+
+/// What `webCall` may ask of a page.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Action {
+    Back,
+    Forward,
+    Reload,
+    Stop,
+    /// Back to `src`, wherever the page went since.
+    Home,
+}
+
+impl Action {
+    fn parse(s: &str) -> Result<Action, String> {
+        Ok(match s {
+            "back" => Action::Back,
+            "forward" => Action::Forward,
+            "reload" => Action::Reload,
+            "stop" => Action::Stop,
+            "home" => Action::Home,
+            other => return Err(format!("webCall: no action {other:?} (back, forward, reload, stop, home)")),
+        })
+    }
+}
+
+/// The same 16 bytes every time for one mod's page id: its WebKit data store.
+pub fn store_id(name: &str, id: &str) -> [u8; 16] {
+    use sha2::{Digest, Sha256};
+    let digest = Sha256::digest(format!("herdr-web\0{name}\0{id}").as_bytes());
+    let mut b = [0u8; 16];
+    b.copy_from_slice(&digest[..16]);
+    // A version 8 (name-based, custom) UUID.
+    b[6] = (b[6] & 0x0f) | 0x80;
+    b[8] = (b[8] & 0x3f) | 0x80;
+    b
+}
+
+struct View {
+    page: imp::Page,
+    spec: Spec,
+    /// The visible part of the element when last painted (window px).
+    rect: Option<Bounds<Pixels>>,
+    /// The paint that put it on screen (`Painter`); 0: not on screen.
+    painter: u64,
+    zoom: f64,
+}
+
+thread_local! {
+    static VIEWS: RefCell<HashMap<Key, View>> = RefCell::new(HashMap::new());
+    /// Each copy's `nextWebEvent()` queue.
+    static EVENTS: RefCell<HashMap<u64, async_channel::Sender<Value>>> = RefCell::new(HashMap::new());
+    static SERIAL: Cell<u64> = const { Cell::new(0) };
+    /// Where GPUI's focus was put when a page took the keyboard; it moving on
+    /// (a shortcut, a dialog closing) takes the keyboard back from the page.
+    static GPUI_FOCUS: RefCell<Option<FocusHandle>> = const { RefCell::new(None) };
+    /// A click in a page waits for the window to move GPUI's focus aside.
+    static FOCUS_PENDING: Cell<bool> = const { Cell::new(false) };
+}
+
+/// A copy's `nextWebEvent()` queue (called when its `herdr` module is built).
+pub fn events(copy: u64) -> async_channel::Receiver<Value> {
+    let (tx, rx) = async_channel::bounded(256);
+    EVENTS.with_borrow_mut(|e| e.insert(copy, tx));
+    rx
+}
+
+/// `{ id, kind, url?, title?, error? }` to the page's mod.
+pub(crate) fn emit(key: &Key, kind: &str, fields: Value) {
+    let mut ev = json!({ "id": key.id, "kind": kind });
+    if let (Some(ev), Some(fields)) = (ev.as_object_mut(), fields.as_object()) {
+        ev.extend(fields.iter().map(|(k, v)| (k.clone(), v.clone())));
+    }
+    EVENTS.with_borrow(|e| {
+        if let Some(tx) = e.get(&key.copy) {
+            let _ = tx.try_send(ev);
+        }
+    });
+}
+
+/// A top-level navigation: whether it may happen here. Elsewhere it opens in
+/// the system browser (http, https, mailto, tel) or nowhere; either way the
+/// mod hears `blocked`.
+pub(crate) fn top_level(key: &Key, rules: &Rules, url: &str) -> bool {
+    match rules.decide(url) {
+        Nav::Allow => true,
+        nav => {
+            if nav == Nav::Outside {
+                crate::links::open(&crate::links::Target::Url(url.to_owned()));
+            }
+            emit(key, "blocked", json!({ "url": url }));
+            false
+        }
+    }
+}
+
+/// A download: the system browser fetches it (a page's blob or data file can't
+/// be handed over and is dropped).
+pub(crate) fn download(key: &Key, url: &str) {
+    if url.starts_with("https://") || url.starts_with("http://") {
+        crate::links::open(&crate::links::Target::Url(url.to_owned()));
+    }
+    emit(key, "blocked", json!({ "url": url }));
+}
+
+/// The element: the mod's children (drawn under the page: seen while it loads
+/// or steps aside) and a probe that records where it was painted.
+pub fn element(copy: u64, rules: &Rc<Rules>, id: &str, props: Value, children: Vec<AnyElement>, window: &mut Window, _cx: &mut App) -> AnyElement {
+    let key = Key { copy, id: id.to_owned() };
+    let el = div().size_full().relative().children(children);
+    // `herdr-app check` and the default policy have no copy: no page.
+    if copy == 0 {
+        return el.into_any_element();
+    }
+    let shown = match &rules.problem {
+        Some(p) => Err(p.clone()),
+        None => Spec::parse(&props, rules).and_then(|spec| ensure(&key, spec, rules, window)),
+    };
+    match shown {
+        Ok(()) => el.child(Probe { key }).into_any_element(),
+        Err(e) => {
+            dispose(&key);
+            el.child(div().absolute().top_0().left_0().p_2().child(e)).into_any_element()
+        }
+    }
+}
+
+/// Creates the page, or loads a new `src` into it.
+fn ensure(key: &Key, spec: Spec, rules: &Rc<Rules>, window: &mut Window) -> Result<(), String> {
+    let same = VIEWS.with_borrow_mut(|v| {
+        let view = v.get_mut(key)?;
+        if view.spec.persist != spec.persist {
+            return Some(false);
+        }
+        if view.spec.src != spec.src {
+            view.page.load(&spec.url);
+        }
+        view.spec = spec.clone();
+        Some(true)
+    });
+    match same {
+        Some(true) => return Ok(()),
+        // Another data store: a new page.
+        Some(false) => dispose(key),
+        None => {}
+    }
+    let page = imp::Page::new(window, key, &spec, rules.clone())?;
+    page.load(&spec.url);
+    VIEWS.with_borrow_mut(|v| v.insert(key.clone(), View { page, spec, rect: None, painter: 0, zoom: 0.0 }));
+    Ok(())
+}
+
+fn dispose(key: &Key) {
+    // Dropped outside the borrow: the page's teardown may call back.
+    let gone = VIEWS.with_borrow_mut(|v| v.remove(key));
+    drop(gone);
+}
+
+/// `webCall(id, action)` from a mod: only its own pages.
+pub fn call(copy: u64, id: &str, action: &str) -> Result<(), String> {
+    let action = Action::parse(action)?;
+    let key = Key { copy, id: id.to_owned() };
+    VIEWS.with_borrow(|v| {
+        v.get(&key).map(|view| match action {
+            Action::Home => view.page.load(&view.spec.url),
+            other => view.page.act(other),
+        })
+    })
+    .ok_or_else(|| format!("webCall: this mod shows no web element {id:?}"))
+}
+
+/// Lives in the probe's element state while the element is on screen (cached
+/// frames keep it too). Dropped when a frame no longer has the element: the
+/// page hides at once.
+struct Painter {
+    key: Key,
+    serial: u64,
+}
+
+impl Drop for Painter {
+    fn drop(&mut self) {
+        // Never busy here (no borrow is held across GPUI's frame); gone at exit.
+        let _ = VIEWS.try_with(|v| {
+            if let Ok(mut v) = v.try_borrow_mut()
+                && let Some(view) = v.get_mut(&self.key).filter(|view| view.painter == self.serial)
+            {
+                view.painter = 0;
+                view.rect = None;
+                view.page.place(None);
+            }
+        });
+    }
+}
+
+struct Probe {
+    key: Key,
+}
+
+impl IntoElement for Probe {
+    type Element = Self;
+    fn into_element(self) -> Self {
+        self
+    }
+}
+
+impl Element for Probe {
+    type RequestLayoutState = ();
+    type PrepaintState = ();
+
+    fn id(&self) -> Option<ElementId> {
+        Some(ElementId::Name(format!("herdr-web-{}-{}", self.key.copy, self.key.id).into()))
+    }
+
+    fn source_location(&self) -> Option<&'static core::panic::Location<'static>> {
+        None
+    }
+
+    fn request_layout(&mut self, _: Option<&GlobalElementId>, _: Option<&InspectorElementId>, window: &mut Window, cx: &mut App) -> (LayoutId, ()) {
+        let mut style = Style { position: Position::Absolute, ..Style::default() };
+        style.inset.top = px(0.).into();
+        style.inset.left = px(0.).into();
+        style.size.width = relative(1.).into();
+        style.size.height = relative(1.).into();
+        (window.request_layout(style, [], cx), ())
+    }
+
+    fn prepaint(&mut self, _: Option<&GlobalElementId>, _: Option<&InspectorElementId>, _: Bounds<Pixels>, _: &mut (), _: &mut Window, _: &mut App) {}
+
+    fn paint(&mut self, id: Option<&GlobalElementId>, _: Option<&InspectorElementId>, bounds: Bounds<Pixels>, _: &mut (), _: &mut (), window: &mut Window, _: &mut App) {
+        let Some(id) = id else { return };
+        let visible = bounds.intersect(&window.content_mask().bounds);
+        let key = self.key.clone();
+        let serial = window.with_element_state::<Painter, _>(id, |state, _| {
+            let p = state.filter(|p| p.key == key).unwrap_or_else(|| {
+                let serial = SERIAL.with(|s| {
+                    s.set(s.get() + 1);
+                    s.get()
+                });
+                Painter { key: key.clone(), serial }
+            });
+            (p.serial, p)
+        });
+        VIEWS.with_borrow_mut(|v| {
+            if let Some(view) = v.get_mut(&self.key) {
+                view.painter = serial;
+                view.rect = Some(visible);
+            }
+        });
+    }
+}
+
+/// What the window knows about its copies this frame.
+pub struct Frame {
+    /// Every loaded copy: a page whose copy isn't here goes.
+    pub alive: HashSet<u64>,
+    /// The copies on screen.
+    pub shown: HashSet<u64>,
+    /// Copies in overlays: their place in the stack (the layout is 0).
+    pub layer: HashMap<u64, usize>,
+    /// Overlays above the layout by place: None covers the whole window (a
+    /// dialog's backdrop, a popup's click-away area); a movable window covers
+    /// its own rect, found under its slot in `rects` once it's laid out.
+    pub covers: Vec<(usize, Option<String>)>,
+    pub rects: Rc<RefCell<HashMap<String, Bounds<Pixels>>>>,
+    /// A pane or mod drag is on: its chip must stay visible.
+    pub dragging: bool,
+}
+
+/// Painted last in the window: places, shows and hides every page.
+pub fn frame_end(frame: Frame) -> impl IntoElement {
+    canvas(|_, _, _| {}, move |_, _, window, cx| apply(frame, window, cx)).absolute().size_full()
+}
+
+fn apply(frame: Frame, window: &mut Window, cx: &mut App) {
+    EVENTS.with_borrow_mut(|e| e.retain(|copy, tx| frame.alive.contains(copy) && !tx.is_closed()));
+    let here = imp::window_of(window);
+    let dead: Vec<Key> = VIEWS.with_borrow(|v| v.iter().filter(|(k, view)| view.page.window() == here && !frame.alive.contains(&k.copy)).map(|(k, _)| k.clone()).collect());
+    for key in dead {
+        dispose(&key);
+    }
+    let zoom = f64::from(crate::settings::zoom());
+    let focus = window.focused(cx);
+    let pending = FOCUS_PENDING.get();
+    let moved = GPUI_FOCUS.with_borrow(|f| *f != focus);
+    VIEWS.with_borrow_mut(|v| {
+        for (key, view) in v.iter_mut().filter(|(_, view)| view.page.window() == here) {
+            let layer = frame.layer.get(&key.copy).copied().unwrap_or(0);
+            let shown = frame.shown.contains(&key.copy) && view.painter != 0;
+            let rect = view.rect.filter(|r| shown && r.size.width >= px(1.) && r.size.height >= px(1.));
+            let covered = |r: &Bounds<Pixels>| {
+                frame.dragging
+                    || frame.covers.iter().filter(|(place, _)| *place > layer).any(|(_, slot)| match slot {
+                        None => true,
+                        Some(slot) => frame.rects.borrow().get(slot).is_some_and(|w| w.intersects(r)),
+                    })
+            };
+            view.page.place(rect.filter(|r| !covered(r)));
+            if view.zoom != view.spec.zoom * zoom {
+                view.zoom = view.spec.zoom * zoom;
+                view.page.zoom(view.zoom);
+            }
+            // GPUI's focus moved on (a key, a closed dialog): the keys follow it.
+            if !pending && moved && view.page.has_keys() {
+                view.page.give_back_keys();
+            }
+        }
+    });
+}
+
+/// A click landed in a page (`imp`'s mouse monitor): the window moves GPUI's
+/// focus aside, so GPUI acts only on its global keys while the page types.
+pub(crate) fn page_clicked() {
+    FOCUS_PENDING.set(true);
+    crate::mods::request(crate::mods::Request::WebFocus);
+}
+
+/// The window did (`Request::WebFocus`): where GPUI's focus now is.
+pub fn focus_set_aside(focus: Option<FocusHandle>) {
+    GPUI_FOCUS.with_borrow_mut(|f| *f = focus);
+    FOCUS_PENDING.set(false);
+}
+
+/// Whether `f` holds for any page (the monitors); false while the registry is busy.
+pub(crate) fn any_page(mut f: impl FnMut(&imp::Page) -> bool) -> bool {
+    VIEWS.with(|v| v.try_borrow().is_ok_and(|v| v.values().any(|view| f(&view.page))))
+}
+
+/// A page's folder for `persist`: `~/.config/herdr-app/web/<mod>/<id>/`. WebKit
+/// keeps the data itself (by `store_id`); the folder names that store, so a
+/// person can tell which it is.
+pub(crate) fn note_store(rules: &Rules, id: &str, uuid: &str) {
+    let simple = |s: &str| !s.is_empty() && s != "." && s != ".." && s.chars().all(|c| c.is_ascii_alphanumeric() || "._-".contains(c));
+    if !simple(&rules.name) || !simple(id) {
+        return;
+    }
+    let dir: PathBuf = crate::mods::app_dir().join("web").join(&rules.name).join(id);
+    let note = format!("WebKit website data store {uuid} (macOS keeps it under ~/Library/WebKit).\n");
+    if std::fs::create_dir_all(&dir).is_ok() && std::fs::read_to_string(dir.join("store")).ok().as_deref() != Some(note.as_str()) {
+        let _ = std::fs::write(dir.join("store"), note);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::path::Path;
+
+    fn rules(allow: Value) -> Rules {
+        Rules::parse("demo", &json!({ "web": { "allow": allow } }), None)
+    }
+
+    #[test]
+    fn the_allowlist_is_exact_origins() {
+        let r = rules(json!(["https://www.example.org", "https://Example.com:8443/"]));
+        assert_eq!(r.problem, None);
+        assert_eq!(r.decide("https://www.example.org/engine/office?tab=class"), Nav::Allow);
+        assert_eq!(r.decide("https://WWW.EXAMPLE.ORG:443/x"), Nav::Allow);
+        assert_eq!(r.decide("https://example.com:8443/a"), Nav::Allow);
+        // Another host, port or scheme leaves for the browser.
+        assert_eq!(r.decide("https://example.org/"), Nav::Outside);
+        assert_eq!(r.decide("https://evil.example.org/"), Nav::Outside);
+        assert_eq!(r.decide("https://www.example.org.evil.com/"), Nav::Outside);
+        assert_eq!(r.decide("https://www.example.org:444/"), Nav::Outside);
+        assert_eq!(r.decide("http://www.example.org/"), Nav::Outside);
+        assert_eq!(r.decide("https://example.com/"), Nav::Outside);
+        assert_eq!(r.decide("https://evil.com@www.example.org/"), Nav::Allow, "userinfo isn't the host");
+        assert_eq!(r.decide("https://www.example.org@evil.com/"), Nav::Outside);
+        assert_eq!(r.decide("mailto:a@b.c"), Nav::Outside);
+        for never in ["javascript:alert(1)", "data:text/html,hi", "blob:https://www.example.org/x", "file:///etc/passwd", "vscode://x", "about:config", "nonsense"] {
+            assert_eq!(r.decide(never), Nav::Block, "{never}");
+        }
+        assert_eq!(r.decide("about:blank"), Nav::Allow);
+    }
+
+    #[test]
+    fn allow_entries_must_be_bare_https_origins() {
+        for bad in [json!(["http://x.org"]), json!(["https://x.org/path"]), json!(["x.org"]), json!(["https://u@x.org"]), json!("https://x.org"), json!([1])] {
+            assert!(rules(bad.clone()).problem.is_some(), "{bad}");
+        }
+        assert!(Rules::parse("demo", &json!({}), None).allow.is_empty());
+        assert_eq!(Rules::parse("demo", &json!({}), None).decide("https://x.org"), Nav::Outside);
+    }
+
+    #[test]
+    fn files_only_from_the_mods_folder() {
+        let root = std::env::temp_dir().join(format!("herdr-web-{}", std::process::id()));
+        let folder = root.join("mod");
+        std::fs::create_dir_all(&folder).unwrap();
+        std::fs::write(folder.join("page.html"), "<p>hi</p>").unwrap();
+        std::fs::write(root.join("secret.html"), "x").unwrap();
+        let r = Rules::parse("demo", &json!({}), std::fs::canonicalize(&folder).ok());
+        let file = |p: &Path| url::Url::from_file_path(p).unwrap().to_string();
+        assert_eq!(r.decide(&file(&folder.join("page.html"))), Nav::Allow);
+        assert_eq!(r.decide(&file(&root.join("secret.html"))), Nav::Block);
+        assert_eq!(r.decide(&format!("{}/../secret.html", file(&folder))), Nav::Block);
+        assert_eq!(r.decide(&file(&folder.join("missing.html"))), Nav::Block);
+        let spec = Spec::parse(&json!({ "src": file(&folder.join("page.html")) }), &r).unwrap();
+        assert_eq!(spec.url.scheme(), "file");
+        assert!(Spec::parse(&json!({ "src": file(&root.join("secret.html")) }), &r).is_err());
+        std::fs::remove_dir_all(&root).unwrap();
+    }
+
+    #[test]
+    fn props_are_checked() {
+        let r = rules(json!(["https://www.example.org"]));
+        let s = Spec::parse(&json!({ "src": "https://www.example.org/engine/office?tab=class" }), &r).unwrap();
+        assert_eq!((s.persist, s.zoom), (false, 1.0));
+        let s = Spec::parse(&json!({ "src": "https://www.example.org/", "persist": true, "zoom": 1.25 }), &r).unwrap();
+        assert_eq!((s.persist, s.zoom), (true, 1.25));
+        for bad in [
+            json!({}),
+            json!({ "src": "https://example.com/" }),
+            json!({ "src": "http://www.example.org/" }),
+            json!({ "src": "javascript:alert(1)" }),
+            json!({ "src": "https://www.example.org/", "persist": "yes" }),
+            json!({ "src": "https://www.example.org/", "zoom": 0 }),
+            json!({ "src": "https://www.example.org/", "zoom": 9 }),
+        ] {
+            assert!(Spec::parse(&bad, &r).is_err(), "{bad}");
+        }
+    }
+
+    #[test]
+    fn calls_are_a_fixed_set() {
+        assert_eq!(Action::parse("back"), Ok(Action::Back));
+        assert_eq!(Action::parse("stop"), Ok(Action::Stop));
+        assert_eq!(Action::parse("home"), Ok(Action::Home));
+        assert!(Action::parse("eval").is_err());
+        assert!(call(7, "nope", "reload").is_err());
+    }
+
+    #[test]
+    fn stores_are_per_mod_and_id() {
+        assert_eq!(store_id("q", "main"), store_id("q", "main"));
+        assert_ne!(store_id("q", "main"), store_id("q", "chat"));
+        assert_ne!(store_id("q", "main"), store_id("r", "main"));
+        assert_eq!(store_id("q", "main")[6] >> 4, 8);
+    }
+
+    #[test]
+    fn events_reach_their_copy() {
+        let rx = events(41);
+        emit(&Key { copy: 41, id: "main".into() }, "title", json!({ "title": "Office" }));
+        emit(&Key { copy: 42, id: "main".into() }, "title", json!({ "title": "elsewhere" }));
+        assert_eq!(rx.try_recv().unwrap(), json!({ "id": "main", "kind": "title", "title": "Office" }));
+        assert!(rx.try_recv().is_err());
+    }
+}
