+pub(crate) fn store_dir(rules: &Rules, id: &str) -> Option<PathBuf> {
     let simple = |s: &str| !s.is_empty() && s != "." && s != ".." && s.chars().all(|c| c.is_ascii_alphanumeric() || "._-".contains(c));
