@@ -0,0 +1,55 @@
+//! `hc doc …`: read and write a core's named JSON documents (doc.get / doc.set) from a shell.
+
+use super::*;
+
+#[derive(Subcommand)]
+pub(super) enum DocCmd {
+    /// Print a document's value (null when never written) and its version.
+    Get {
+        name: String,
+        /// Another machine's core.
+        #[arg(long)]
+        on: Option<String>,
+    },
+    /// Write JSON (the argument, or what is piped in with -) as the document; null deletes it.
+    Set {
+        name: String,
+        /// The JSON value, or - to read it from what is piped in.
+        value: String,
+        /// Another machine's core.
+        #[arg(long)]
+        on: Option<String>,
+        /// Only if the document is still at this version (from doc get); default: whatever it is now.
+        #[arg(long)]
+        version: Option<u64>,
+    },
+}
+
+pub(super) fn doc(action: DocCmd, call: impl Fn(&str, Value) -> Result<Value, RpcError>) -> Result<Out, RpcError> {
+    Ok(match action {
+        DocCmd::Get { name, on } => {
+            let r = call("doc.get", json!({ "name": name, "on": on }))?;
+            let human = serde_json::to_string_pretty(&r["value"]).unwrap_or_default();
+            Out { json: r, human }
+        }
+        DocCmd::Set { name, value, on, version } => {
+            let text = if value == "-" { String::from_utf8_lossy(&piped(1 << 20)?).into_owned() } else { value };
+            let value: Value = serde_json::from_str(&text)
+                .map_err(|e| RpcError::new("usage", format!("not JSON: {e}"), "quote it: hc doc set n '{\"a\":1}'"))?;
+            let set = |version: u64| call("doc.set", json!({ "name": name, "on": on, "value": value, "version": version }));
+            let r = match version {
+                Some(v) => set(v)?,
+                // No version given: last writer wins; one retry covers a write landing in between.
+                None => {
+                    let now = || call("doc.get", json!({ "name": name, "on": on })).map(|r| r["version"].as_u64().unwrap_or(0));
+                    match set(now()?) {
+                        Err(e) if e.kind == "conflict" => set(now()?)?,
+                        r => r?,
+                    }
+                }
+            };
+            let human = format!("{name}: version {}", r["version"]);
+            Out { json: r, human }
+        }
+    })
+}
