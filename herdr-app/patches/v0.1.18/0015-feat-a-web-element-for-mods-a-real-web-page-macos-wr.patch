+//! The macOS side of web elements: wry's WKWebView as a child of GPUI's view,
+//! plus what wry leaves out here:
+//!
+//! - a navigation delegate in place of wry's, which tells a page's top level
+//!   from its frames (wry's handler only gets a URL), hands downloads to the
+//!   browser and reports failed loads and a crashed web process;
+//! - a UI delegate in place of wry's: new windows load in the page itself,
+//!   the microphone and camera only for allowed origins (wry's permission
+//!   handler gets no origin), and the file picker for `<input type=file>`;
+//! - URL changes inside a page (`history.pushState`), watched with KVO;
+//! - the keyboard: a click outside every page gives it back to GPUI, and the
+//!   editing keys reach a page that types (wry gives child web views no key
+//!   equivalents, and Herdr has no Edit menu to send copy: and paste:).
+//!
+//! Main thread only, like everything AppKit; the registry lives in `super`.
+
+#![allow(unused_unsafe)]
+
+use super::{Action, Key, Rules, Spec};
+use block2::RcBlock;
+use gpui::{Bounds, Pixels, Window};
+use objc2::rc::{Retained, Weak};
+use objc2::runtime::{AnyObject, NSObject, ProtocolObject, Sel};
+use objc2::{DefinedClass, MainThreadMarker, MainThreadOnly, define_class, msg_send, sel};
+use objc2_app_kit::{NSApplication, NSEvent, NSEventMask, NSEventModifierFlags, NSModalResponseOK, NSOpenPanel, NSResponder, NSView, NSWindow};
+use objc2_foundation::{
+    NSArray, NSDictionary, NSError, NSHTTPURLResponse, NSKeyValueChangeKey, NSKeyValueObservingOptions, NSObjectNSKeyValueObserverRegistration, NSObjectProtocol, NSPoint,
+    NSProcessInfo, NSRect, NSSize, NSString, NSURL, NSURLRequest, NSUUID, ns_string,
+};
+use objc2_web_kit::{
+    WKAudiovisualMediaTypes, WKFrameInfo, WKMediaCaptureType, WKNavigation, WKNavigationAction, WKNavigationActionPolicy, WKNavigationDelegate, WKNavigationResponse,
+    WKNavigationResponsePolicy, WKOpenPanelParameters, WKPermissionDecision, WKSecurityOrigin, WKUIDelegate, WKWebView, WKWebViewConfiguration, WKWebsiteDataStore,
+    WKWindowFeatures,
+};
+use raw_window_handle::{HasWindowHandle, RawWindowHandle};
+use serde_json::json;
+use std::cell::{Cell, RefCell};
+use std::ffi::c_void;
+use std::ptr::NonNull;
+use std::rc::Rc;
+use wry::{WebViewBuilder, WebViewBuilderExtDarwin, WebViewBuilderExtMacos, WebViewExtMacOS};
+
+/// What a page's delegates share: whose it is, its rules, what was last said.
+struct Status {
+    key: Key,
+    rules: Rc<Rules>,
+    url: RefCell<String>,
+    title: RefCell<String>,
+    /// Reloaded once after its web process died; a finished load resets it.
+    revived: Cell<bool>,
+}
+
+impl Status {
+    fn url_changed(&self, url: String) {
+        if self.url.replace(url.clone()) != url {
+            super::emit(&self.key, "url", json!({ "url": url }));
+        }
+    }
+
+    fn title_changed(&self, title: String) {
+        if self.title.replace(title.clone()) != title {
+            super::emit(&self.key, "title", json!({ "title": title }));
+        }
+    }
+}
+
+fn url_of(view: &WKWebView) -> Option<String> {
+    unsafe { view.URL() }.and_then(|u| u.absoluteString()).map(|s| s.to_string())
+}
+
+pub struct Page {
+    web: wry::WebView,
+    view: Retained<WKWebView>,
+    rules: Rc<Rules>,
+    _nav: Retained<NavDelegate>,
+    _ui: Retained<UiDelegate>,
+    _url: Retained<UrlObserver>,
+    /// GPUI's view: the page's superview, and where the keys go back to.
+    gpui: Weak<NSView>,
+    window: usize,
+    /// The frame last applied (None: hidden), in GPUI's view.
+    placed: Option<Option<NSRect>>,
+}
+
+impl Page {
+    pub fn new(window: &mut Window, key: &Key, spec: &Spec, rules: Rc<Rules>) -> Result<Page, String> {
+        let mtm = MainThreadMarker::new().ok_or("web pages live on the main thread")?;
+        install_monitors(mtm);
+        let here = window_of(window);
+        let config = unsafe { WKWebViewConfiguration::new(mtm) };
+        let store = if spec.persist {
+            if NSProcessInfo::processInfo().operatingSystemVersion().majorVersion < 14 {
+                return Err("persist needs macOS 14 or later".into());
+            }
+            let uuid = NSUUID::from_bytes(super::store_id(&rules.name, &key.id));
+            super::note_store(&rules, &key.id, &uuid.UUIDString().to_string());
+            unsafe { WKWebsiteDataStore::dataStoreForIdentifier(&uuid, mtm) }
+        } else {
+            // Cookies and storage in memory only: gone with the page.
+            unsafe { WKWebsiteDataStore::nonPersistentDataStore(mtm) }
+        };
+        unsafe {
+            config.setWebsiteDataStore(&store);
+            // Some sign-in pages refuse web views that don't say Safari.
+            config.setApplicationNameForUserAgent(Some(&NSString::from_str(&safari_name())));
+            // Pages may play sound without a click first (read-aloud answers).
+            config.setMediaTypesRequiringUserActionForPlayback(WKAudiovisualMediaTypes::None);
+        }
+        let status = Rc::new(Status { key: key.clone(), rules: rules.clone(), url: RefCell::default(), title: RefCell::default(), revived: Cell::new(false) });
+        let titles = status.clone();
+        let web = WebViewBuilder::new()
+            .with_webview_configuration(config)
+            .with_visible(false)
+            .with_focused(false)
+            .with_devtools(false)
+            .with_back_forward_navigation_gestures(true)
+            // Force click's preview would show any link's page, allowed or not.
+            .with_allow_link_preview(false)
+            .with_document_title_changed_handler(move |title| titles.title_changed(title))
+            .build_as_child(&*window)
+            .map_err(|e| format!("cannot open a web view: {e}"))?;
+        let view: Retained<WKWebView> = Retained::into_super(web.webview());
+        let nav = NavDelegate::new(mtm, status.clone());
+        let ui = UiDelegate::new(mtm, status.clone());
+        unsafe {
+            view.setNavigationDelegate(Some(ProtocolObject::from_ref(&*nav)));
+            view.setUIDelegate(Some(ProtocolObject::from_ref(&*ui)));
+        }
+        let url = UrlObserver::new(mtm, view.clone(), status);
+        let gpui = unsafe { view.superview() }.ok_or("the web view is not in a window")?;
+        view.setHidden(true);
+        Ok(Page { web, view, rules, _nav: nav, _ui: ui, _url: url, gpui: Weak::from_retained(&gpui), window: here, placed: None })
+    }
+
+    pub fn load(&self, url: &url::Url) {
+        load_into(&self.view, url.as_str(), &self.rules);
+    }
+
+    /// Moves the page to `rect` (window px, top-left origin), or hides it.
+    pub fn place(&mut self, rect: Option<Bounds<Pixels>>) {
+        let Some(gpui) = self.gpui.load() else { return };
+        let frame = rect.map(|b| {
+            // Whole device pixels, so the page's edges are as sharp as GPUI's.
+            let scale = gpui.window().map_or(2.0, |w| w.backingScaleFactor());
+            let snap = |v: Pixels| (f64::from(v) * scale).round() / scale;
+            let (x, y, w, h) = (snap(b.origin.x), snap(b.origin.y), snap(b.size.width), snap(b.size.height));
+            let y = if gpui.isFlipped() { y } else { gpui.bounds().size.height - y - h };
+            NSRect::new(NSPoint::new(x, y), NSSize::new(w, h))
+        });
+        if self.placed == Some(frame) {
+            return;
+        }
+        self.placed = Some(frame);
+        match frame {
+            Some(f) => {
+                self.view.setFrame(f);
+                self.view.setHidden(false);
+            }
+            None => {
+                // A hidden first responder would leave the keys with nobody.
+                if self.has_keys() {
+                    self.give_back_keys();
+                }
+                self.view.setHidden(true);
+            }
+        }
+    }
+
+    pub fn zoom(&mut self, zoom: f64) {
+        let _ = self.web.zoom(zoom);
+    }
+
+    pub fn act(&self, action: Action) {
+        let _ = match action {
+            Action::Back => self.web.go_back(),
+            Action::Forward => self.web.go_forward(),
+            Action::Reload => self.web.reload(),
+            Action::Stop => {
+                unsafe { self.view.stopLoading() };
+                Ok(())
+            }
+            // web.rs loads `src` itself.
+            Action::Home => Ok(()),
+        };
+    }
+
+    /// The keyboard is in this page.
+    pub fn has_keys(&self) -> bool {
+        let Some(window) = self.view.window() else { return false };
+        window.firstResponder().is_some_and(|r| r.downcast_ref::<NSView>().is_some_and(|v| v.isDescendantOf(&self.view)))
+    }
+
+    pub fn give_back_keys(&self) {
+        if let (Some(gpui), Some(window)) = (self.gpui.load(), self.view.window()) {
+            let responder: &NSResponder = &gpui;
+            window.makeFirstResponder(Some(responder));
+        }
+    }
+
+    pub fn window(&self) -> usize {
+        self.window
+    }
+
+    fn in_window(&self, window: &NSWindow) -> bool {
+        self.view.window().is_some_and(|w| std::ptr::eq(&*w, window))
+    }
+
+    /// Shown in `window` at `p` (window coordinates, bottom-left origin).
+    fn under(&self, window: &NSWindow, p: NSPoint) -> bool {
+        if self.view.isHidden() || !self.in_window(window) {
+            return false;
+        }
+        let f = self.view.convertRect_toView(self.view.bounds(), None);
+        p.x >= f.origin.x && p.y >= f.origin.y && p.x < f.origin.x + f.size.width && p.y < f.origin.y + f.size.height
+    }
+}
+
+impl Drop for Page {
+    fn drop(&mut self) {
+        if self.has_keys() {
+            self.give_back_keys();
+        }
+        unsafe {
+            self.view.stopLoading();
+            self.view.setNavigationDelegate(None);
+            self.view.setUIDelegate(None);
+        }
+        // wry's WebView, dropped next, takes the view out of the window.
+    }
+}
+
+/// The window's GPUI view, which identifies the window.
+pub fn window_of(window: &Window) -> usize {
+    match HasWindowHandle::window_handle(window).map(|h| h.as_raw()) {
+        Ok(RawWindowHandle::AppKit(h)) => h.ns_view.as_ptr() as usize,
+        _ => 0,
+    }
+}
+
+/// Safari's name for this macOS (26 from macOS 26 on; before, macOS + 3).
+fn safari_name() -> String {
+    let major = NSProcessInfo::processInfo().operatingSystemVersion().majorVersion;
+    let safari = if major >= 26 { major } else { major + 3 };
+    format!("Version/{safari}.0 Safari/605.1.15")
+}
+
+/// Loads `url` (already allowed): a file with read access to the mod's folder only.
+fn load_into(view: &WKWebView, url: &str, rules: &Rules) {
+    let Some(u) = NSURL::URLWithString(&NSString::from_str(url)) else { return };
+    unsafe {
+        if url.starts_with("file:") {
+            if let Some(folder) = &rules.folder {
+                view.loadFileURL_allowingReadAccessToURL(&u, &NSURL::fileURLWithPath(&NSString::from_str(&folder.to_string_lossy())));
+            }
+        } else {
+            view.loadRequest(&NSURLRequest::requestWithURL(&u));
+        }
+    }
+}
+
+thread_local! {
+    /// The two event monitors, installed with the first page, kept for good.
+    static MONITORS: RefCell<Vec<Retained<AnyObject>>> = const { RefCell::new(Vec::new()) };
+}
+
+fn install_monitors(mtm: MainThreadMarker) {
+    if MONITORS.with_borrow(|m| !m.is_empty()) {
+        return;
+    }
+    // Before AppKit hands a click to a view: in a page, GPUI's focus steps
+    // aside; elsewhere, a page holding the keys gives them back to GPUI first.
+    let clicks = RcBlock::new(move |ev: NonNull<NSEvent>| -> *mut NSEvent {
+        let event = unsafe { ev.as_ref() };
+        if let Some(window) = event.window(mtm) {
+            let p = event.locationInWindow();
+            if super::any_page(|page| page.under(&window, p)) {
+                super::page_clicked();
+            } else {
+                let mut gpui = None;
+                // Only in the page's own window (not a file panel or a page's menu).
+                super::any_page(|page| {
+                    gpui = (page.in_window(&window) && page.has_keys()).then(|| page.gpui.load()).flatten();
+                    gpui.is_some()
+                });
+                if let Some(g) = gpui {
+                    let responder: &NSResponder = &g;
+                    window.makeFirstResponder(Some(responder));
+                }
+            }
+        }
+        ev.as_ptr()
+    });
+    // Before GPUI's key equivalents: while a page types, the editing keys are
+    // its own (GPUI would copy from or paste into a terminal).
+    let keys = RcBlock::new(move |ev: NonNull<NSEvent>| -> *mut NSEvent {
+        let event = unsafe { ev.as_ref() };
+        if let Some(action) = editing_action(event)
+            && let Some(window) = event.window(mtm)
+            && super::any_page(|page| page.in_window(&window) && page.has_keys())
+            && unsafe { NSApplication::sharedApplication(mtm).sendAction_to_from(action, None, None) }
+        {
+            return std::ptr::null_mut();
+        }
+        ev.as_ptr()
+    });
+    let mouse = NSEventMask::LeftMouseDown | NSEventMask::RightMouseDown | NSEventMask::OtherMouseDown;
+    let installed = unsafe { [NSEvent::addLocalMonitorForEventsMatchingMask_handler(mouse, &clicks), NSEvent::addLocalMonitorForEventsMatchingMask_handler(NSEventMask::KeyDown, &keys)] };
+    MONITORS.with_borrow_mut(|m| m.extend(installed.into_iter().flatten()));
+}
+
+/// Cmd with C, X, V, A or Z (and their Shift forms): the standard action a
+/// text view's Edit menu would send.
+fn editing_action(event: &NSEvent) -> Option<Sel> {
+    let flags = event.modifierFlags();
+    if !flags.contains(NSEventModifierFlags::Command) || flags.intersects(NSEventModifierFlags::Control | NSEventModifierFlags::Option) {
+        return None;
+    }
+    let shift = flags.contains(NSEventModifierFlags::Shift);
+    let key = event.charactersIgnoringModifiers()?.to_string().to_lowercase();
+    Some(match (key.as_str(), shift) {
+        ("c", _) => sel!(copy:),
+        ("x", _) => sel!(cut:),
+        ("v", false) => sel!(paste:),
+        ("v", true) => sel!(pasteAsPlainText:),
+        ("a", _) => sel!(selectAll:),
+        ("z", false) => sel!(undo:),
+        ("z", true) => sel!(redo:),
+        _ => return None,
+    })
+}
