From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jayweihung <3034830+jayweihung@users.noreply.github.com>
Date: Mon, 16 Nov 2026 18:06:20 +0800
Subject: [PATCH 28/31] fix: the app drops an hc identity it was started with
 (opened from a terminal in Herdr), so a mod's hc runs as the app, not that
 terminal

---
 src/main.rs | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/main.rs b/src/main.rs
index 33e4337..df2dd63 100644
--- a/src/main.rs
+++ b/src/main.rs
@@ -86,6 +86,12 @@ fn attach_console() {
 }
 
 fn main() {
+    // Started from a terminal in Herdr (`open` there): its hc identity would come along, and every hc a mod runs would
+    // be sent as that terminal (an Agents menu's /compact then arrives as a message from it, not typed in). The app is
+    // no terminal: drop it. HC_SESSION stays (it picks which core on purpose). main has not started any threads yet.
+    for var in ["HC_TERMINAL_ID", "HC_TERMINAL_SOCKET", "HC_SCOPE"] {
+        unsafe { std::env::remove_var(var) };
+    }
     let args: Vec<String> = std::env::args().collect();
     #[cfg(target_os = "macos")]
     macos_check::startup(&args);
