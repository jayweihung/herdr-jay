+        assert_eq!(states, [Some("silent"), Some("working"), Some("working"), Some("blocked"), Some("working")]);
+        let chains: Vec<_> = g.chains.iter().map(|c| (c.path.join(">"), c.why.as_str())).collect();
+        assert_eq!(chains, [("h>a>b".to_string(), "silent"), ("e>f>g".to_string(), "blocked")]);
