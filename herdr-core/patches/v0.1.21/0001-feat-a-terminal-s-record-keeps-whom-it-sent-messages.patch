+    #[test]
+    fn sends_count_per_receiver_keep_the_last_first_line_and_drop_the_oldest() {
+        let mut r = Registry::default();
+        let id = r.create(new(None), 0).unwrap();
+        let t = r.terminals.get_mut(&id).unwrap();
+        t.note_sent("t2", "\r\n  hi there  \r\nmore", 5);
+        t.note_sent("t3", "x", 6);
+        t.note_sent("t2", &"é".repeat(300), 7);
+        assert_eq!(t.sent.iter().map(|s| s.to.as_str()).collect::<Vec<_>>(), ["t3", "t2"], "latest last");
+        assert_eq!((t.sent[1].count, t.sent[1].last_ms), (2, 7));
+        assert_eq!(t.sent[1].text.chars().count(), 120);
+        t.note_sent("t3", "\r\n  hi there  \r\nmore", 8);
+        assert_eq!(t.sent[1].text, "hi there", "Windows line ends too");
+        for n in 0..MAX_SENT {
+            t.note_sent(&format!("box/t{n}"), "x", 9);
+        }
+        assert_eq!(t.sent.len(), MAX_SENT);
+        assert!(t.sent.iter().all(|s| s.to.starts_with("box/")), "the oldest receivers went first");
+    }
+
