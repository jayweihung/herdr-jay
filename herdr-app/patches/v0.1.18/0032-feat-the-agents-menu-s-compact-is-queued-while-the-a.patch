+  // 壓縮: one per agent per cycle (shared "compact/<address>", the kit mod's too). Typed in now if it waits, else
+  // queued: the list types it in once this turn ends. Pressed again meanwhile, it only says so.
+  compact(a, text, name) {
+    const key = compactKey(a.address), now = Date.now();
+    if (compactLive(shared(key), now)) return void notify({ title: "已經在壓縮了", body: name, level: "info", timeout: 3000 });
+    const job = { state: "queued", at: now, text };
+    setShared(key, job);
+    if (a.status === "idle" || a.status === "done") return this.compactNext(a, job, "send", name, terminals().find((x) => x.address === a.address)?.turn);
+    notify({ title: "已排隊，這輪結束後壓縮", body: name, level: "info", timeout: 4000 });
+  }
+
+  // a compact's next step (compactStep): typed in (marked sent first, so no other copy or mod types it too), ended,
+  // or given up
+  compactNext(a, e, step, name, turn) {
+    const key = compactKey(a.address);
+    if (step === "send") {
+      setShared(key, { ...e, state: "sent", sent: Date.now(), turn: Number.isFinite(turn) ? turn : null });
+      const failed = (r) => {
+        if (shared(key)?.at === e.at) setShared(key, null);
+        notify({ title: "沒有送出壓縮", body: (r?.stderr || r?.stdout || "hc 沒有回應").trim().slice(0, 300), level: "warning" });
+      };
+      return hc(sendTo(a, e.text)).then((r) => (r?.code === 0 ? notify({ title: "壓縮中…", body: name, level: "info", timeout: 3000 }) : failed(r)), () => failed(null));
+    }
+    setShared(key, null);
+    if (step === "done") notify({ title: "壓縮好了", body: name, level: "success", timeout: 3000 });
+    else if (step === "timeout") notify({ title: e.state === "sent" ? "壓縮沒等到結束" : "排隊的壓縮取消了", level: "warning", timeout: 6000,
+      body: `${name}：${e.state === "sent" ? "3 分鐘還沒看到它壓縮完，不再等（看一下它的畫面）" : "等了 30 分鐘它還沒停下來，沒有送出"}` });
+  }
