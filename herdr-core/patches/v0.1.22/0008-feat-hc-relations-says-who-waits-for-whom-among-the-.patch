@@ -0,0 +1,657 @@
+//! Who waits for whom among the agents running now, read from their records
+//! (`sent`, `parent`, `history`), so every app shows the same judgement.
+//! Deciding only: records in, the result out.
+//!
+//! Left to the apps, since only they know it: workspaces, the names a person
+//! gave, what a person is looking at, notes, usage limits, sub-agents.
+
+use schemars::JsonSchema;
+use serde::Serialize;
+use serde_json::Value;
+use std::collections::BTreeSet;
+
+const MIN: u64 = 60_000;
+/// Waiting for you longer than this is waiting too long.
+pub const LONG_WAIT: u64 = 10 * MIN;
+/// Idle longer than this, with nobody waiting for it: it could be closed.
+pub const IDLE_CLOSE: u64 = 30 * MIN;
+/// How long after a message the receiver must have stopped for that to count as not answering it.
+const SETTLE: u64 = 1500;
+/// A sender working this long past the receiver's stop had the answer in reach: not waiting.
+const MOVED_ON: u64 = 60_000;
+
+#[derive(Serialize, JsonSchema, Debug, Default)]
+pub struct Relations {
+    /// Live terminals whose program reports a status, as `terminal.list` orders them.
+    pub nodes: Vec<Node>,
+    /// Messages (`hc send` from inside one) and who started whom, between nodes.
+    pub edges: Vec<Edge>,
+    /// The same with one end on a node, the other not.
+    pub outside: Vec<Edge>,
+    /// `from` messaged `to` last and has stopped; `to` hasn't answered.
+    pub waits: Vec<Wait>,
+    /// Waits following each other to one that is stuck, or round to the start.
+    pub chains: Vec<Chain>,
+    /// Two or more working at once in one folder (or one inside the other) on one machine.
+    pub clashes: Vec<Clash>,
+    /// Every node waiting for a person (blocked).
+    pub blocked: Vec<Blocked>,
+    /// Blocked for over 10 minutes.
+    pub long_waits: Vec<LongWait>,
+    /// Idle for over 30 minutes, nobody waits for it and it started nobody running now.
+    pub idle: Vec<Idle>,
+}
+
+#[derive(Serialize, JsonSchema, Debug, Clone, Default)]
+pub struct Node {
+    pub address: String,
+    /// The machine part of its address; empty here.
+    pub machine: String,
+    /// Its name, else its title, else its address.
+    pub name: String,
+    /// Its status word.
+    pub status: String,
+    /// What a blocked one waits for (permission, question, auth), when it said.
+    pub kind: String,
+    /// When its word last changed (ms since the epoch); 0 if not known.
+    pub since: u64,
+    /// The folder it works in now, else the one it started in.
+    pub cwd: String,
+}
+
+#[derive(Serialize, JsonSchema, Debug, Clone)]
+pub struct Edge {
+    pub from: String,
+    pub to: String,
+    /// `send`, or `parent` (from started to).
+    pub kind: String,
+    /// How many messages (0 for parent).
+    pub count: u64,
+    /// The last message's time, or when the child was created.
+    pub at: u64,
+    /// The last message's first line.
+    pub text: String,
+}
+
+#[derive(Serialize, JsonSchema, Debug, Clone)]
+pub struct Wait {
+    pub from: String,
+    pub to: String,
+    /// When the message went in.
+    pub at: u64,
+    pub text: String,
+    /// How `to` stands: working (on it), blocked (needs a person) or silent (stopped, no answer).
+    pub state: String,
+    /// When `to` stopped (0 while working).
+    pub since: u64,
+    /// How long ago the message went in (ms).
+    pub waited: u64,
+    /// What to type into `to` to remind it to answer.
+    pub nudge: String,
+}
+
+#[derive(Serialize, JsonSchema, Debug, Clone)]
+pub struct Chain {
+    /// Each one waits for the next.
+    pub path: Vec<String>,
+    pub end: String,
+    /// blocked or silent (how the last stands), or loop (it comes back to itself).
+    pub why: String,
+}
+
+#[derive(Serialize, JsonSchema, Debug, Clone)]
+pub struct Clash {
+    pub nodes: Vec<String>,
+    /// The outermost of their folders.
+    pub dir: String,
+}
+
+#[derive(Serialize, JsonSchema, Debug, Clone)]
+pub struct Blocked {
+    pub address: String,
+    /// For how long (ms); 0 if not known.
+    #[serde(rename = "for")]
+    pub for_ms: u64,
+    pub kind: String,
+    /// What it asks: the message it reported with its status, at most 160 characters.
+    pub ask: String,
+    /// Waiting too long (over 10 minutes).
+    pub hot: bool,
+}
+
+#[derive(Serialize, JsonSchema, Debug, Clone)]
+pub struct LongWait {
+    pub address: String,
+    #[serde(rename = "for")]
+    pub for_ms: u64,
+    pub kind: String,
+}
+
+#[derive(Serialize, JsonSchema, Debug, Clone)]
+pub struct Idle {
+    pub address: String,
+    #[serde(rename = "for")]
+    pub for_ms: u64,
+}
+
+/// One status word from a record's history.
+struct Was<'a> {
+    address: &'a str,
+    state: &'a str,
+    at: u64,
+}
+
+fn text(v: &Value) -> &str {
+    v.as_str().unwrap_or_default()
+}
+
+/// The relations among `records` (as `terminal.list` gives them) at `now`.
+pub fn of(records: &[Value], now: u64) -> Relations {
+    let log: Vec<Was> = records
+        .iter()
+        .flat_map(|r| {
+            let history = r["history"].as_array().map(Vec::as_slice).unwrap_or_default();
+            history.iter().map(|w| Was {
+                address: text(&r["address"]),
+                state: text(&w["state"]),
+                at: w["at_ms"].as_u64().unwrap_or(0),
+            })
+        })
+        .collect();
+    let nodes: Vec<Node> = records
+        .iter()
+        .filter(|r| r["state"] == "live" && r["status"]["state"].is_string())
+        .map(|r| {
+            let address = text(&r["address"]);
+            let began = log.iter().filter(|w| w.address == address).map(|w| w.at).max().unwrap_or(0);
+            let named = [&r["name"], &r["title"]].into_iter().map(text).find(|s| !s.is_empty());
+            let cwd = Some(text(&r["foreground"]["cwd"])).filter(|s| !s.is_empty()).unwrap_or(text(&r["cwd"]));
+            Node {
+                address: address.into(),
+                machine: address.split_once('/').map_or("", |(m, _)| m).into(),
+                name: named.unwrap_or(address).into(),
+                status: text(&r["status"]["state"]).into(),
+                kind: text(&r["status"]["kind"]).into(),
+                since: r["status_ms"].as_u64().unwrap_or(0).max(began),
+                cwd: cwd.into(),
+            }
+        })
+        .collect();
+    let mut lines = Vec::new();
+    for r in records {
+        let address = text(&r["address"]);
+        for s in r["sent"].as_array().into_iter().flatten() {
+            if !text(&s["to"]).is_empty() && text(&s["to"]) != address {
+                lines.push(Edge {
+                    from: address.into(),
+                    to: text(&s["to"]).into(),
+                    kind: "send".into(),
+                    count: s["count"].as_u64().filter(|c| *c > 0).unwrap_or(1),
+                    at: s["last_ms"].as_u64().unwrap_or(0),
+                    text: text(&s["text"]).into(),
+                });
+            }
+        }
+        if let Some(parent) = r["parent"].as_str().filter(|p| *p != address) {
+            let at = r["created_ms"].as_u64().unwrap_or(0);
+            lines.push(Edge {
+                from: parent.into(),
+                to: address.into(),
+                kind: "parent".into(),
+                count: 0,
+                at,
+                text: String::new(),
+            });
+        }
+    }
+    let has = |a: &str| nodes.iter().any(|n| n.address == a);
+    let (edges, rest): (Vec<Edge>, Vec<Edge>) = lines.into_iter().partition(|l| has(&l.from) && has(&l.to));
+    let outside: Vec<Edge> = rest.into_iter().filter(|l| has(&l.from) != has(&l.to)).collect();
+    let waits = waits_of(&nodes, &edges, &outside, &log, now);
+    let chains = chains_of(&waits);
+    let clashes = clashes_of(&nodes);
+    // No `down` here: an offline machine's terminals aren't in the list at all.
+    let live = || nodes.iter().filter(|n| n.since > 0);
+    let long_waits = live()
+        .filter(|n| n.status == "blocked" && now.saturating_sub(n.since) >= LONG_WAIT)
+        .map(|n| LongWait { address: n.address.clone(), for_ms: now.saturating_sub(n.since), kind: n.kind.clone() })
+        .collect();
+    let blocked = nodes
+        .iter()
+        .filter(|n| n.status == "blocked")
+        .map(|n| {
+            let record = records.iter().find(|r| r["address"] == n.address.as_str()).expect("a node is a record");
+            let msg = text(&record["status"]["msg"]).split_whitespace().collect::<Vec<_>>().join(" ");
+            let for_ms = if n.since > 0 { now.saturating_sub(n.since) } else { 0 };
+            let (kind, ask) = (n.kind.clone(), ask(&msg).chars().take(160).collect());
+            Blocked { address: n.address.clone(), for_ms, kind, ask, hot: n.since > 0 && for_ms >= LONG_WAIT }
+        })
+        .collect();
+    let waited: BTreeSet<&str> = waits.iter().map(|w| w.to.as_str()).collect();
+    let parents: BTreeSet<&str> = edges.iter().filter(|e| e.kind == "parent").map(|e| e.from.as_str()).collect();
+    // The panel also leaves out the one a person is looking at, one waiting for the
+    // owner's OK, at a usage limit, or whose last words ask something: the core knows none of these.
+    let idle = live()
+        .filter(|n| n.status == "idle" && now.saturating_sub(n.since) >= IDLE_CLOSE)
+        .filter(|n| !waited.contains(n.address.as_str()) && !parents.contains(n.address.as_str()))
+        .map(|n| Idle { address: n.address.clone(), for_ms: now.saturating_sub(n.since) })
+        .collect();
+    Relations { nodes, edges, outside, waits, chains, clashes, blocked, long_waits, idle }
+}
+
+/// What it asks, without the program's own lead word ("answer: ...").
+fn ask(msg: &str) -> &str {
+    for lead in ["answer", "allow", "approve"] {
+        if let Some(rest) = msg.get(..lead.len()).filter(|s| s.eq_ignore_ascii_case(lead)).map(|_| &msg[lead.len()..])
+            && let Some(rest) = rest.trim_start().strip_prefix(':')
+        {
+            return rest.trim_start();
+        }
+    }
+    msg
+}
+
+/// A message that says it wants no answer: 「不用回」「不用再回」「不必回」, [FYI].
+pub fn no_reply(text: &str) -> bool {
+    ["不用回", "不用再回", "不必回", "不必再回"].iter().any(|w| text.contains(w))
+        || text.to_lowercase().contains("[fyi]")
+}
+
+/// A waits for B: A messaged B more times than B messaged A (an answer evens them
+/// out), the last one after B's last, and A has stopped (it isn't working on
+/// something else, and hasn't moved on since B stopped).
+fn waits_of(nodes: &[Node], edges: &[Edge], outside: &[Edge], log: &[Was], now: u64) -> Vec<Wait> {
+    let node = |a: &str| nodes.iter().find(|n| n.address == a);
+    let last = |a: &str, b: &str| edges.iter().find(|e| e.kind == "send" && e.from == a && e.to == b);
+    let first_stop = |b: &str, at: u64| {
+        log.iter().filter(|x| x.address == b && x.state != "working" && x.at > at).map(|x| x.at).min()
+    };
+    let worked_after = |a: &str, at: u64| log.iter().any(|x| x.address == a && x.state == "working" && x.at > at);
+    let sent_after =
+        |a: &str, at: u64| edges.iter().chain(outside).any(|e| e.kind == "send" && e.from == a && e.at > at);
+    let mut out = Vec::new();
+    for e in edges.iter().filter(|e| e.kind == "send") {
+        let (Some(a), Some(b)) = (node(&e.from), node(&e.to)) else { continue };
+        let back = last(&e.to, &e.from);
+        if back.is_some_and(|x| x.at >= e.at || x.count >= e.count) || a.status == "working" || no_reply(&e.text) {
+            continue;
+        }
+        let state = match b.status.as_str() {
+            "working" => "working",
+            "blocked" => "blocked",
+            _ if b.since > e.at + SETTLE => "silent",
+            _ => "working", // stopped before the message settled in: still on it
+        };
+        if state == "silent" {
+            // A moved on after B's first stop since the message (worked again, messaged
+            // anyone, or kept working well past it): it got what it needed some other way.
+            let stopped = first_stop(&e.to, e.at + SETTLE).unwrap_or(b.since);
+            if worked_after(&e.from, stopped + SETTLE)
+                || sent_after(&e.from, stopped + SETTLE)
+                || a.since > stopped + MOVED_ON
+            {
+                continue;
+            }
+        }
+        let mut w = Wait {
+            from: e.from.clone(),
+            to: e.to.clone(),
+            at: e.at,
+            text: e.text.clone(),
+            state: state.into(),
+            since: if state == "working" { 0 } else { b.since },
+            waited: now.saturating_sub(e.at),
+            nudge: String::new(),
+        };
+        w.nudge = nudge_text(nodes, &w);
+        out.push(w);
+    }
+    out
+}
+
+/// What is typed into one that stopped without answering. No <hc> tag, so its
+/// reply hook doesn't take it for a message from another agent.
+pub fn nudge_text(nodes: &[Node], w: &Wait) -> String {
+    let name = nodes.iter().find(|n| n.address == w.from).map_or(w.from.as_str(), |n| n.name.as_str());
+    let first: String = w.text.chars().take(80).collect();
+    let quoted = if first.is_empty() { String::new() } else { format!("（開頭：「{first}」）") };
+    format!(
+        "[Herdr 提醒] 你還沒回 {name} 傳給你的訊息{quoted}。要回就用 hc send 回給它（位址在那則訊息開頭的 from 裡）；只是通知、不用回的話，不必理會這則。"
+    )
+}
+
+/// Following each one's newest wait to one that waits for nobody (blocked or
+/// silent: stuck; working: fine, left out) or one already on the way (loop).
+/// The longest first, none inside another; a loop once.
+fn chains_of(waits: &[Wait]) -> Vec<Chain> {
+    let mut sorted: Vec<&Wait> = waits.iter().collect();
+    sorted.sort_by_key(|w| w.at);
+    // Kept in the order each one first waits; its newest wait wins.
+    let mut next: Vec<(&str, &Wait)> = Vec::new();
+    for w in sorted {
+        match next.iter_mut().find(|(from, _)| *from == w.from) {
+            Some(entry) => entry.1 = w,
+            None => next.push((&w.from, w)),
+        }
+    }
+    let next_of = |a: &str| next.iter().find(|(from, _)| *from == a).map(|(_, w)| *w);
+    let waited_on: BTreeSet<&str> = waits.iter().map(|w| w.to.as_str()).collect();
+    let mut found = Vec::new();
+    for (start, first) in &next {
+        let mut path = vec![start.to_string()];
+        let (mut why, mut w) = (None, Some(*first));
+        while let Some(at) = w {
+            if path.contains(&at.to) {
+                why = Some("loop");
+                break;
+            }
+            path.push(at.to.clone());
+            w = next_of(&at.to);
+            if w.is_none() {
+                why = (at.state != "working").then_some(at.state.as_str());
+            }
+        }
+        if let Some(why) = why {
+            found.push(Chain { end: path.last().cloned().unwrap_or_default(), path, why: why.into() });
+        }
+    }
+    found.sort_by_key(|c| std::cmp::Reverse(c.path.len()));
+    let joined = |c: &Chain| c.path.join(">");
+    let key = |c: &Chain| {
+        let mut path = c.path.clone();
+        if c.why == "loop" {
+            path.sort();
+        }
+        path.join(">")
+    };
+    let mut seen = BTreeSet::new();
+    let mut kept = Vec::new();
+    for (i, c) in found.iter().enumerate() {
+        let others = || found.iter().enumerate().filter(move |(j, _)| *j != i).map(|(_, o)| o);
+        let k = key(c);
+        if seen.contains(&k)
+            || others().any(|o| o.path.len() > c.path.len() && joined(o).ends_with(&joined(c)))
+            || (c.why != "loop"
+                && waited_on.contains(c.path[0].as_str())
+                && others().any(|o| o.path.contains(&c.path[0])))
+        {
+            continue;
+        }
+        seen.insert(k);
+        kept.push(c.clone());
+    }
+    kept
+}
+
+/// A home folder: everyone starts there, not a shared project.
+fn is_home(d: &str) -> bool {
+    let d = d.strip_suffix(['/', '\\']).unwrap_or(d);
+    let one = |rest: Option<&str>, seps: &[char]| rest.is_some_and(|r| !r.is_empty() && !r.contains(seps));
+    let windows = d.len() > 3 && d.as_bytes()[0].is_ascii_alphabetic() && d.as_bytes()[1] == b':' && {
+        let rest = d[2..].strip_prefix(['/', '\\']).and_then(|r| r.strip_prefix("Users"));
+        one(rest.and_then(|r| r.strip_prefix(['/', '\\'])), &['/', '\\'])
+    };
+    d == "/root" || one(d.strip_prefix("/Users/"), &['/']) || one(d.strip_prefix("/home/"), &['/']) || windows
+}
+
+fn norm(d: &str) -> String {
+    d.replace('\\', "/").trim_end_matches('/').to_lowercase()
+}
+
+/// Working at the same time in one folder on one machine (or one inside the other's).
+fn clashes_of(nodes: &[Node]) -> Vec<Clash> {
+    struct Group<'a> {
+        machine: &'a str,
+        key: String,
+        dir: &'a str,
+        nodes: Vec<String>,
+    }
+    let mut groups: Vec<Group> = Vec::new();
+    for n in nodes.iter().filter(|n| n.status == "working" && !n.cwd.is_empty() && !is_home(&n.cwd)) {
+        let d = norm(&n.cwd);
+        let inside =
+            |g: &Group| g.key == d || d.starts_with(&format!("{}/", g.key)) || g.key.starts_with(&format!("{d}/"));
+        match groups.iter_mut().find(|g| g.machine == n.machine && inside(g)) {
+            Some(g) => {
+                g.nodes.push(n.address.clone());
+                if d.len() < g.key.len() {
+                    (g.key, g.dir) = (d, &n.cwd);
+                }
+            }
+            None => groups.push(Group { machine: &n.machine, key: d, dir: &n.cwd, nodes: vec![n.address.clone()] }),
+        }
+    }
+    groups.into_iter().filter(|g| g.nodes.len() > 1).map(|g| Clash { nodes: g.nodes, dir: g.dir.into() }).collect()
+}
