+            assert!(!super::icon_ok(bad), "{bad}");
+        }
+        let program = json!({ "key": "claude", "icon": "icons/claude.svg", "tint": true, "tile": "#000", "color": "#fff" });
+        let own = super::with_icon(program.clone(), Some(&json!({ "herdr.icon": "data/kit/bots/v2/fox.svg" })));
