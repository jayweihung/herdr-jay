diff --git a/crates/herdr-core/src/cli/doc.rs b/crates/herdr-core/src/cli/doc.rs
index 5c1110b..efaf328 100644
--- a/crates/herdr-core/src/cli/doc.rs
+++ b/crates/herdr-core/src/cli/doc.rs
@@ -36,12 +36,15 @@ pub(super) fn doc(action: DocCmd, call: impl Fn(&str, Value) -> Result<Value, Rp
             let text = if value == "-" { String::from_utf8_lossy(&piped(1 << 20)?).into_owned() } else { value };
             let value: Value = serde_json::from_str(&text)
                 .map_err(|e| RpcError::new("usage", format!("not JSON: {e}"), "quote it: hc doc set n '{\"a\":1}'"))?;
-            let set = |version: u64| call("doc.set", json!({ "name": name, "on": on, "value": value, "version": version }));
+            let set =
+                |version: u64| call("doc.set", json!({ "name": name, "on": on, "value": value, "version": version }));
             let r = match version {
                 Some(v) => set(v)?,
                 // No version given: last writer wins; one retry covers a write landing in between.
                 None => {
-                    let now = || call("doc.get", json!({ "name": name, "on": on })).map(|r| r["version"].as_u64().unwrap_or(0));
+                    let now = || {
+                        call("doc.get", json!({ "name": name, "on": on })).map(|r| r["version"].as_u64().unwrap_or(0))
+                    };
                     match set(now()?) {
                         Err(e) if e.kind == "conflict" => set(now()?)?,
                         r => r?,
