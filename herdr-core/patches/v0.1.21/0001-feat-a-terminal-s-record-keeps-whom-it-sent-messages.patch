diff --git a/crates/herdr-core/src/terminals.rs b/crates/herdr-core/src/terminals.rs
index 503e4f4..6eb3f4e 100644
--- a/crates/herdr-core/src/terminals.rs
+++ b/crates/herdr-core/src/terminals.rs
@@ -138,9 +138,41 @@ pub struct Terminal {
     /// Machines (core ids) it started work on: they may call back to it.
     #[serde(default, skip_serializing_if = "std::collections::BTreeSet::is_empty")]
     pub afar: std::collections::BTreeSet<String>,
+    /// Who its program sent messages to (`hc send` from inside it), the latest
+    /// last: one entry per receiver, so a panel can draw who talks to whom.
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub sent: Vec<Sent>,
+}
+
+/// Receivers a terminal remembers sending to; the oldest goes first.
+pub const MAX_SENT: usize = 32;
+/// How much of the last message it keeps.
+const SENT_TEXT: usize = 120;
+
+/// Messages from one terminal to one receiver.
+#[derive(Serialize, Deserialize, JsonSchema, Clone, Debug, PartialEq)]
+pub struct Sent {
+    /// The receiver as this core names it: `t7`, or `box/t7` on another machine.
+    pub to: String,
+    /// How many messages.
+    pub count: u64,
+    /// When the last one went in.
+    pub last_ms: u64,
+    /// The last one's first line, cut at 120 characters.
+    pub text: String,
 }
 
 impl Terminal {
+    /// One more message from it to `to`.
+    pub fn note_sent(&mut self, to: &str, text: &str, now_ms: u64) {
+        let line = text.lines().map(str::trim).find(|l| !l.is_empty()).unwrap_or_default();
+        let count = self.sent.iter().position(|s| s.to == to).map_or(0, |i| self.sent.remove(i).count);
+        self.sent.push(Sent { to: to.into(), count: count + 1, last_ms: now_ms, text: line.chars().take(SENT_TEXT).collect() });
+        if self.sent.len() > MAX_SENT {
+            self.sent.remove(0);
+        }
+    }
+
     pub fn id(&self) -> u32 {
         parse_id(&self.address).expect("addresses are t<number>")
     }
