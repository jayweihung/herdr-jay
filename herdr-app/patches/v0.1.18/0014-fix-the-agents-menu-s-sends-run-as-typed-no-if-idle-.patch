-    const menu = (a) => openOverlay({ mod: "agents", kind: "popup", at: "pointer", width: 240, height: 420, props: { agentMenu: a.address } });
+    const menu = (a) => openOverlay({ mod: "agents", kind: "popup", at: "pointer", width: 240, height: 420, props: { agentMenu: a.address, name: /^\d+$/.test(label(a) ?? "") ? a.program?.name || label(a) : label(a) } });
     const row = (a, i, subs = []) => {
       const pic = icon(a.program, 16, t.foreground);
       const more = detail.get(a.address);
