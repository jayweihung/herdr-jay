+
+/// A mod's drags (an element's `on_drag`) dropped on a space, for its copies'
+/// nextDrop(): one channel per mod, so each drop goes to one copy, whichever
+/// waits, even when the copy that started the drag has closed.
+#[derive(Clone)]
+struct Drops {
+    tx: async_channel::Sender<Value>,
+    rx: async_channel::Receiver<Value>,
+    /// nextDrop() calls pending now (a closed copy's are cancelled).
+    waiting: std::sync::Arc<std::sync::atomic::AtomicUsize>,
+}
+
+struct Waiting(std::sync::Arc<std::sync::atomic::AtomicUsize>);
+impl Waiting {
+    fn new(count: &std::sync::Arc<std::sync::atomic::AtomicUsize>) -> Self {
+        count.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+        Waiting(count.clone())
+    }
+}
+impl Drop for Waiting {
+    fn drop(&mut self) {
+        self.0.fetch_sub(1, std::sync::atomic::Ordering::SeqCst);
+    }
+}
+
+thread_local! {
+    static DROPS: RefCell<HashMap<String, Drops>> = RefCell::new(HashMap::new());
+    /// Each copy's application name (`Instance::key`) and its mod: a drag's `source`.
+    static APPLICATIONS: RefCell<HashMap<String, String>> = RefCell::new(HashMap::new());
+}
+
+fn drops_of(inst: &Instance) -> Drops {
+    APPLICATIONS.with_borrow_mut(|a| a.insert(inst.key(), inst.name.clone()));
+    DROPS.with_borrow_mut(|d| {
+        d.entry(inst.name.clone())
+            .or_insert_with(|| {
+                let (tx, rx) = async_channel::unbounded();
+                Drops { tx, rx, waiting: Default::default() }
+            })
+            .clone()
+    })
+}
+
+/// Hands a mod drag dropped on a space (an `on_drag_drop` event) to the mod
+/// that started it: `{payload, space}` to a copy waiting in nextDrop(), the
+/// space as spaces() lists it. Returns whether one took it.
+pub fn drop_on_space(drop: &Value, space: &str) -> bool {
+    let (Some(source), Some(payload)) = (drop["source"].as_str(), drop["payload"].as_str()) else {
+        return false;
+    };
+    let Some(name) = APPLICATIONS.with_borrow(|a| a.get(source).cloned()) else {
+        tracing::warn!("a drag from {source:?} was dropped, but no mod started it");
+        return false;
+    };
+    let Some(space) = SNAPSHOT.with(|s| s.borrow().spaces.as_array()?.iter().find(|s| s["id"] == space).cloned()) else {
+        return false;
+    };
+    let Some(drops) = DROPS.with_borrow(|d| d.get(&name).cloned()) else { return false };
+    if drops.waiting.load(std::sync::atomic::Ordering::SeqCst) == 0 {
+        tracing::warn!("mod {name}: a drag was dropped on a space, but no copy waits in nextDrop()");
+        return false;
+    }
+    drops.tx.try_send(json!({ "payload": payload, "space": space })).is_ok()
 }
 
