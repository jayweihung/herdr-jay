+            // A node alone in its row or column, like pane.zoom; again (or another id) shows the rest.
+            "layout.zoom" => {
+                let id = Self::arg(a, "id").unwrap_or_default().to_owned();
+                if self.chrome.find(&id).is_none() {
+                    return self.fail(format!("no node {id:?} in the shown layout"));
+                }
+                let mut again = false;
+                if let Some((was, hid)) = self.zoom_hid.take() {
+                    for h in hid {
+                        if let Some(n) = self.chrome.find_mut(&h) {
+                            n.hidden = false;
+                        }
+                    }
+                    again = was == id;
+                }
+                let mut hid = Vec::new();
+                if !again
+                    && let Some(parent) = parent_of_mut(&mut self.chrome, &id)
+                    && matches!(parent.kind, Kind::Row { .. } | Kind::Column { .. })
+                    && let Some(children) = parent.children_mut()
+                {
+                    for c in children.iter_mut().filter(|c| c.id != id && !c.hidden) {
+                        c.hidden = true;
+                        hid.push(c.id.clone());
+                    }
+                }
+                if !hid.is_empty() {
+                    self.zoom_hid = Some((id, hid));
+                }
+            }
             "layout.resize" => {
                 let id = Self::arg(a, "id").unwrap_or_default();
                 let Some(n) = self.find_node_mut(id) else { return self.fail(format!("no node {id:?}")) };
