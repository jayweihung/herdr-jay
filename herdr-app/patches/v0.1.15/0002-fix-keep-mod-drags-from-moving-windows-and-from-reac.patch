diff --git a/src/mods/drops.rs b/src/mods/drops.rs
new file mode 100644
index 0000000..de08910
--- /dev/null
+++ b/src/mods/drops.rs
@@ -0,0 +1,117 @@
+//! A mod's drags (an element's `on_drag`) dropped on a space: `nextDrop()` for
+//! the mod that started one, `dropOnSpace()` for the panels that list spaces.
+//! One channel per mod, so each drop goes to one copy, whichever waits, even
+//! when the copy that started the drag has closed.
+
+use super::{Instance, SNAPSHOT, from_host, to_host};
+use gpui_shell::{HostError, HostModule, HostValue};
+use serde_json::{Value, json};
+use std::cell::RefCell;
+use std::collections::{BTreeSet, HashMap};
+use std::sync::Arc;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::time::{Duration, Instant};
+
+/// A drop older than this when a copy reads it was meant for a copy that went
+/// away meanwhile: it's dropped, not acted on later.
+const FRESH: Duration = Duration::from_secs(2);
+
+#[derive(Clone)]
+struct Drops {
+    tx: async_channel::Sender<(Instant, Value)>,
+    rx: async_channel::Receiver<(Instant, Value)>,
+    /// nextDrop() calls pending now (a closed copy's are cancelled).
+    waiting: Arc<AtomicUsize>,
+}
+
+struct Waiting(Arc<AtomicUsize>);
+impl Waiting {
+    fn new(count: &Arc<AtomicUsize>) -> Self {
+        count.fetch_add(1, Ordering::SeqCst);
+        Waiting(count.clone())
+    }
+}
+impl Drop for Waiting {
+    fn drop(&mut self) {
+        self.0.fetch_sub(1, Ordering::SeqCst);
+    }
+}
+
+thread_local! {
+    static DROPS: RefCell<HashMap<String, Drops>> = RefCell::new(HashMap::new());
+    /// A drag's `source` (its copy's application name, `Instance::key`) and the
+    /// mods that name can be: name and props run together, so two can share one.
+    static APPLICATIONS: RefCell<HashMap<String, BTreeSet<String>>> = RefCell::new(HashMap::new());
+}
+
+/// Adds `nextDrop` and `dropOnSpace` to a copy's `herdr` module.
+pub(super) fn register(module: HostModule, inst: &Instance) -> HostModule {
+    APPLICATIONS.with_borrow_mut(|a| a.entry(inst.key()).or_default().insert(inst.name.clone()));
+    let drops = DROPS.with_borrow_mut(|d| {
+        d.entry(inst.name.clone())
+            .or_insert_with(|| {
+                let (tx, rx) = async_channel::unbounded();
+                Drops { tx, rx, waiting: Default::default() }
+            })
+            .clone()
+    });
+    module
+        .async_function("nextDrop", move |_| {
+            let (rx, waiting) = (drops.rx.clone(), Waiting::new(&drops.waiting));
+            Ok(async move {
+                let _waiting = waiting;
+                loop {
+                    let (at, drop) = rx.recv().await.map_err(|_| HostError::new("herdr-app is shutting down"))?;
+                    if at.elapsed() < FRESH {
+                        return Ok(to_host(&drop));
+                    }
+                }
+            })
+        })
+        .function("dropOnSpace", |a| Ok(HostValue::Bool(drop_on_space(&from_host(a.value(0)?), a.string(1)?))))
+}
+
+/// Hands a mod drag dropped on a space (an `on_drag_drop` event) to the mod
+/// that started it: `{payload, space}` to a copy waiting in nextDrop(), the
+/// space as spaces() lists it. Returns whether one was waiting.
+fn drop_on_space(drop: &Value, space: &str) -> bool {
+    let (Some(source), Some(payload)) = (drop["source"].as_str(), drop["payload"].as_str()) else {
+        return false;
+    };
+    let names = APPLICATIONS.with_borrow(|a| a.get(source).cloned()).unwrap_or_default();
+    let [name] = names.iter().collect::<Vec<_>>()[..] else {
+        tracing::warn!("a drag from {source:?} was dropped, but {} mods go by that name", names.len());
+        return false;
+    };
+    let Some(space) = SNAPSHOT.with(|s| s.borrow().spaces.as_array()?.iter().find(|s| s["id"] == space).cloned()) else {
+        return false;
+    };
+    let Some(drops) = DROPS.with_borrow(|d| d.get(name).cloned()) else { return false };
+    if drops.waiting.load(Ordering::SeqCst) == 0 {
+        tracing::warn!("mod {name}: a drag was dropped on a space, but no copy waits in nextDrop()");
+        return false;
+    }
+    drops.tx.try_send((Instant::now(), json!({ "payload": payload, "space": space }))).is_ok()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_source_two_mods_go_by_reaches_neither() {
+        super::super::publish_spaces(json!([{ "id": "s1" }]));
+        let waiting = |inst: &Instance| {
+            let module = register(HostModule::new("herdr"), inst);
+            DROPS.with_borrow(|d| d[&inst.name].waiting.fetch_add(1, Ordering::SeqCst));
+            module
+        };
+        let props = Instance { name: "kit".into(), props: json!(1) };
+        let plain = Instance { name: "kit1".into(), props: Value::Null };
+        assert_eq!(props.key(), plain.key());
+        let _modules = (waiting(&props), waiting(&plain), waiting(&Instance { name: "solo".into(), props: Value::Null }));
+        assert!(!drop_on_space(&json!({ "source": "kit1", "payload": "x" }), "s1"));
+        assert!(drop_on_space(&json!({ "source": "solo", "payload": "x" }), "s1"));
+        assert!(!drop_on_space(&json!({ "source": "solo", "payload": "x" }), "elsewhere"));
+    }
+}
