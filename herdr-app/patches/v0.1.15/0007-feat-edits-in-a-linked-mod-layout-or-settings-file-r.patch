+    #[test]
+    fn edits_in_a_linked_mod_or_layout_reload_it() {
+        let base = Path::new("/home/probe");
+        let links = [
+            Link { target: "/src/repo/mods/gerrit".into(), rel: "mods/gerrit".into(), dir: true },
+            Link { target: "/src/repo/layouts/jay.json".into(), rel: "layouts/jay.json".into(), dir: false },
+        ];
+        let event = |p: &str| Ok(notify::Event::new(notify::EventKind::Any).add_path(PathBuf::from(p)));
+        assert_eq!(changes(base, &links, event("/src/repo/mods/gerrit/review.js")).0, vec![PathBuf::from("mods/gerrit/review.js")]);
+        assert_eq!(changes(base, &links, event("/src/repo/layouts/jay.json")).0, vec![PathBuf::from("layouts/jay.json")]);
+        // the linked file's folder is watched: its neighbours are not this home's files
+        assert!(changes(base, &links, event("/src/repo/layouts/other.json")).0.is_empty());
+        assert!(changes(base, &links, event("/src/repo/README.md")).0.is_empty());
+        let mut revisions = Revisions::default();
+        let (changed, rescan) = changes(base, &links, event("/src/repo/mods/gerrit/main.js"));
+        revisions.changed(&changed, rescan);
+        assert!(revisions.roots[Path::new("mods/gerrit")] > 0);
+    }
