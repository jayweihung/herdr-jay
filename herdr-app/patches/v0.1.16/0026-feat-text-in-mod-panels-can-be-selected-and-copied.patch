+// HERDR: a view's plain text can be dragged over, selected and copied; a press
+// that does not drag still clicks what it lands on; controls and press-owning
+// elements keep their labels plain.
+#[gpui::test]
+fn plain_text_selects_and_copies_while_clicks_still_click(cx: &mut TestAppContext) {
+    cx.update(crate::init);
+    let runtime = ShellRuntime::new_isolated().expect("runtime");
+    cx.update(|cx| runtime.set_global(cx));
+    let source = r#"
+import { View, div } from "gpui-kit";
+import { v_flex, Button } from "gpui-base";
+
+export default class Selectable extends View {
+  init() { this.rowClicks = 0; this.buttonClicks = 0; this.presses = 0; }
+  render(cx) {
+    return v_flex()
+      .w(300)
+      .text_size(14)
+      .child(div().h(40).child("alpha beta"))
+      .child(div().h(40).child("gamma delta"))
+      .child(div().id("row").h(40).cursor_pointer()
+        .on_click((_e, cx) => { this.rowClicks += 1; cx.notify(); })
+        .child(div().child(`row clicks ${this.rowClicks}`)))
+      .child(Button.new("button").h(40).w(300)
+        .on_click((_e, cx) => { this.buttonClicks += 1; cx.notify(); })
+        .child(`button clicks ${this.buttonClicks}`))
+      .child(div().id("pressed").h(40)
+        .on_mouse_down("left", (_e, cx) => { this.presses += 1; cx.notify(); })
+        .child(`presses ${this.presses}`))
+      .child(div().w(40).h(40).truncate().child("a line far too long for its box"));
+  }
+}
+"#;
+    let view_type = runtime.load_source("selectable.js", source).expect("load");
+    let runtime_for_view = Rc::clone(&runtime);
+    let script_view = Rc::new(RefCell::new(None));
+    let (_root, context) = cx.add_window_view({
+        let script_view = Rc::clone(&script_view);
+        move |window, cx| {
+            let object = runtime_for_view
+                .instantiate(&view_type, window, cx)
+                .expect("instantiate");
+            let view = cx.new(|_| ScriptView::new(runtime_for_view, object));
+            *script_view.borrow_mut() = Some(view.clone());
+            crate::root::ShellRoot::new(view.into(), window, cx)
+        }
+    });
+    let script_view = script_view.borrow().clone().expect("script view");
+    let tree = |context: &mut VisualTestContext| {
+        context.update(|_, cx| {
+            script_view
+                .read(cx)
+                .snapshot()
+                .map(crate::RenderSnapshot::debug_tree)
+                .unwrap_or_default()
+        })
+    };
+    let drag = |context: &mut VisualTestContext, from: (f32, f32), to: (f32, f32)| {
+        let (from, to) = (point(px(from.0), px(from.1)), point(px(to.0), px(to.1)));
+        context.simulate_mouse_down(from, gpui::MouseButton::Left, Modifiers::default());
+        context.simulate_mouse_move(to, Some(gpui::MouseButton::Left), Modifiers::default());
+        context.simulate_mouse_up(to, gpui::MouseButton::Left, Modifiers::default());
+        context.run_until_parked();
+        context.update(|window, cx| window.draw(cx).clear(cx));
+        context.update(|window, cx| gpui_base::TextSelection::selected_text(window, cx))
+    };
+    context.update(|window, cx| window.draw(cx).clear(cx));
+
+    // One run, then two in reading order (what the copy key copies).
+    assert_eq!(drag(context, (1., 10.), (290., 10.)), "alpha beta");
+    assert_eq!(drag(context, (1., 10.), (290., 50.)), "alpha beta\ngamma delta");
+
+    // A plain click on a clickable row's text clicks the row, and selects nothing.
+    context.simulate_click(point(px(10.), px(90.)), Modifiers::default());
+    context.run_until_parked();
+    context.update(|window, cx| window.draw(cx).clear(cx));
+    assert!(tree(context).contains("row clicks 1"), "{}", tree(context));
+    assert!(!context.update(|window, cx| gpui_base::TextSelection::has_selection(window, cx)));
+
+    // A press that wobbles a pixel is still a click.
+    assert_eq!(drag(context, (10., 90.), (12., 90.)), "");
+    assert!(tree(context).contains("row clicks 2"), "{}", tree(context));
+
+    // Dragging over the row's text selects it, and is not a click.
+    assert_eq!(drag(context, (1., 90.), (290., 90.)), "row clicks 2");
+    assert!(tree(context).contains("row clicks 2"), "{}", tree(context));
+
+    // A button's label is the button's: a drag over it selects nothing and,
+    // released on the button, still presses it, as it always did.
+    assert_eq!(drag(context, (1., 130.), (290., 130.)), "");
+    assert!(tree(context).contains("button clicks 1"), "{}", tree(context));
+    context.simulate_click(point(px(150.), px(140.)), Modifiers::default());
+    context.run_until_parked();
+    assert!(tree(context).contains("button clicks 2"), "{}", tree(context));
+
+    // An element that handles the press itself keeps its text plain.
+    assert_eq!(drag(context, (1., 170.), (290., 170.)), "");
+    assert!(tree(context).contains("presses 1"), "{}", tree(context));
+
+    // Cut-off text keeps its ellipsis and offers nothing half-selected.
+    assert_eq!(drag(context, (1., 210.), (39., 210.)), "");
+}
