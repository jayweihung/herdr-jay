+    /// The layout as it is without layout.zoom's hiding (what is saved).
+    fn unzoomed(&self) -> Node {
+        let mut n = self.chrome.clone();
+        for h in self.zoom_hid.iter().flat_map(|(_, hid)| hid) {
+            if let Some(x) = n.find_mut(h) {
+                x.hidden = false;
+            }
+        }
+        n
+    }
