From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jayweihung <3034830+jayweihung@users.noreply.github.com>
Date: Mon, 16 Nov 2026 02:55:13 +0800
Subject: [PATCH 19/22] fix: a zoomed layout node fills its row or column, and
 quitting with a web page open no longer aborts

---
 src/web.rs    | 27 +++++++++++++++++++--------
 src/window.rs | 28 ++++++++++++++++++++--------
 2 files changed, 39 insertions(+), 16 deletions(-)

diff --git a/src/web.rs b/src/web.rs
index 280aa9c..e9e903f 100644
--- a/src/web.rs
+++ b/src/web.rs
@@ -241,8 +241,19 @@ struct View {
     zoom: f64,
 }
 
+fn with_views_mut<R>(f: impl FnOnce(&mut HashMap<Key, View>) -> R) -> R {
+    VIEWS.with(|c| f(&mut c.borrow_mut()))
+}
+
+fn with_views<R>(f: impl FnOnce(&HashMap<Key, View>) -> R) -> R {
+    VIEWS.with(|c| f(&c.borrow()))
+}
+
 thread_local! {
-    static VIEWS: RefCell<HashMap<Key, View>> = RefCell::new(HashMap::new());
+    // Never dropped: at quit the main thread's locals go after AppKit is
+    // tearing down, and dropping a web view then aborts ("Herdr quit
+    // unexpectedly"). The process is ending; the system takes them back.
+    static VIEWS: std::mem::ManuallyDrop<RefCell<HashMap<Key, View>>> = std::mem::ManuallyDrop::new(RefCell::new(HashMap::new()));
     /// Each copy's `nextWebEvent()` queue.
     static EVENTS: RefCell<HashMap<u64, async_channel::Sender<Value>>> = RefCell::new(HashMap::new());
     static SERIAL: Cell<u64> = const { Cell::new(0) };
@@ -322,7 +333,7 @@ pub fn element(copy: u64, rules: &Rc<Rules>, id: &str, props: Value, children: V
 
 /// Creates the page, or loads a new `src` into it.
 fn ensure(key: &Key, spec: Spec, rules: &Rc<Rules>, window: &mut Window) -> Result<(), String> {
-    let same = VIEWS.with_borrow_mut(|v| {
+    let same = with_views_mut(|v| {
         let view = v.get_mut(key)?;
         if view.spec.persist != spec.persist {
             return Some(false);
@@ -341,13 +352,13 @@ fn ensure(key: &Key, spec: Spec, rules: &Rc<Rules>, window: &mut Window) -> Resu
     }
     let page = imp::Page::new(window, key, &spec, rules.clone())?;
     page.load(&spec.url);
-    VIEWS.with_borrow_mut(|v| v.insert(key.clone(), View { page, spec, rect: None, painter: 0, zoom: 0.0 }));
+    with_views_mut(|v| v.insert(key.clone(), View { page, spec, rect: None, painter: 0, zoom: 0.0 }));
     Ok(())
 }
 
 fn dispose(key: &Key) {
     // Dropped outside the borrow: the page's teardown may call back.
-    let gone = VIEWS.with_borrow_mut(|v| v.remove(key));
+    let gone = with_views_mut(|v| v.remove(key));
     drop(gone);
 }
 
@@ -355,7 +366,7 @@ fn dispose(key: &Key) {
 pub fn call(copy: u64, id: &str, action: &str) -> Result<(), String> {
     let action = Action::parse(action)?;
     let key = Key { copy, id: id.to_owned() };
-    VIEWS.with_borrow(|v| {
+    with_views(|v| {
         v.get(&key).map(|view| match action {
             Action::Home => view.page.load(&view.spec.url),
             other => view.page.act(other),
@@ -435,7 +446,7 @@ impl Element for Probe {
