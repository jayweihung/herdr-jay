 }
 
+/// The row, column or stack that holds the node `id`.
+fn parent_of_mut<'a>(n: &'a mut Node, id: &str) -> Option<&'a mut Node> {
+    if n.children().iter().any(|c| c.id == id) {
+        return Some(n);
+    }
+    n.children_mut()?.iter_mut().find_map(|c| parent_of_mut(c, id))
+}
