@@ -0,0 +1,43 @@
+import { test, expect } from "bun:test";
+import { readFile } from "node:fs/promises";
+
+const source = (await readFile(new URL("../defaults/mods/menu/main.js", import.meta.url), "utf8"))
+  .replace(/^import .*;\n/gm, "").replace("export default class Menu", "class Menu").replace(/^export /gm, "");
+
+const SPACES = [{ id: "s1", folder: "/Users/amy/ai", machine: null }, { id: "box/s2", folder: "", machine: "box" }];
+const KIT = { id: "kit", label: "Kit…", labels: { s1: "Kit：~/ai" }, width: 440, height: 560, props: { role: "space" } };
+function menu(more: unknown = null) {
+  const opened: unknown[] = [], runs: unknown[] = [];
+  const { items, Menu } = new Function("View", "spaces", "shared", "props", "closeOverlay", "openOverlay", "run", `${source}; return { items, Menu };`)(
+    class {}, () => SPACES, (k: string) => (k === "spaces.menu" ? more : null), () => ({ tab: "space", target: { id: "box/s2" } }),
+    () => {}, (o: unknown) => opened.push(o), (...a: unknown[]) => runs.push(a),
+  );
+  return { items, Menu, opened, runs };
+}
+
+test("a space's menu: items other mods add (shared spaces.menu) before Close, with that space's label", () => {
+  const { items } = menu();
+  const more = { kit: { at: 1000, items: [KIT] } };
+  const labels = (id: string, m: unknown = more, now = 2000) => items({ tab: "space", target: { id } }, null, m, now).map((i: unknown[]) => i[0]);
+  expect(labels("s1")).toEqual(["Rename", "Kit：~/ai", "Close"]);
+  expect(labels("box/s2")).toEqual(["Rename", "Kit…", "Close"]);
+  // said 10 minutes ago or more (the mod may be gone), or not an item: left out
+  expect(labels("s1", more, 1000 + 600000)).toEqual(["Rename", "Close"]);
+  expect(labels("s1", { kit: { at: 1000, items: [{ label: "no id" }, null] }, other: null })).toEqual(["Rename", "Close"]);
+  // a space that is gone: only Herdr's own
+  expect(labels("gone")).toEqual(["Rename", "Close"]);
+  // no size given: the popup's own; an item's props can't replace the space
+  const bare = items({ tab: "space", target: { id: "s1" } }, null, { x: { at: 1000, items: [{ id: "a", label: "A", props: { space: "other", n: 1 } }] } }, 2000)[1][2];
+  expect(bare).toEqual({ mod: "x", kind: "popup", props: { space: "s1", n: 1, folder: "/Users/amy/ai", machine: null } });
+});
+
+test("picking a mod's item opens that mod with the space, its folder and machine; Herdr's own still run", () => {
+  const { Menu, opened, runs } = menu({ kit: { at: Date.now(), items: [KIT] } });
+  const m = new Menu();
+  m.git = null;
+  m.choose(1, null);
+  expect(opened).toEqual([{ mod: "kit", kind: "popup", width: 440, height: 560, props: { role: "space", space: "box/s2", folder: "", machine: "box" } }]);
+  expect(runs).toEqual([]);
+  m.choose(0, null);
+  expect(runs).toEqual([["space.rename", { id: "box/s2" }]]);
+});
