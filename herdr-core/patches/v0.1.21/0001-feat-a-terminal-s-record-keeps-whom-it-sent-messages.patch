diff --git a/crates/herdr-core/src/notes.rs b/crates/herdr-core/src/notes.rs
index 1e389fc..2256885 100644
--- a/crates/herdr-core/src/notes.rs
+++ b/crates/herdr-core/src/notes.rs
@@ -140,6 +140,31 @@ impl Core {
     /// Text from the agent `from` (a caller address) to the agent `to`, wrapped in
     /// a tag that says who sent it. As is when either isn't an agent: a person,
     /// a shell, a dialog. `reach`: also say how to answer (a worker's first message).
+    /// A send from a terminal here went in (here or on another machine): its
+    /// record keeps whom it talks to. `params` as the caller sent them.
+    pub fn sent(&self, params: &serde_json::Value) {
+        let (Some(from), Some(to)) = (params["caller"].as_str().and_then(parse_id), params["terminal"].as_str()) else {
+            return;
+        };
+        let mut st = self.lock();
+        let here = |local: &str| st.reg.resolve(local).map_or_else(|_| local.to_string(), crate::terminals::address);
+        let to = match to.split_once('/') {
+            Some((m, local)) if m != self.info.id && m != self.info.name => {
+                let machine = st.machines.iter().find(|x| x.id == m || x.name == m).map(|x| x.name.as_str());
+                let peer = st.peers.iter().find(|(id, p)| *id == m || p.name == m).map(|(_, p)| p.name.as_str());
+                format!("{}/{local}", machine.or(peer).unwrap_or(m))
+            }
+            Some((_, local)) => here(local),
+            None => here(to),
+        };
+        let text = params["text"].as_str().unwrap_or_default();
+        let Some(t) = st.reg.terminals.get_mut(&from).filter(|t| t.address != to) else { return };
+        t.note_sent(&to, text, now_ms());
+        let sent = serde_json::to_value(&t.sent).unwrap_or_default();
+        self.save(&st);
+        self.emit(&mut st, "sent", from, serde_json::json!({ "sent": sent }));
+    }
+
