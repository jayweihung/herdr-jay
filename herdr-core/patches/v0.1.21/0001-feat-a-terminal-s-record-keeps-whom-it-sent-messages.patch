+#[test]
+fn a_send_from_a_terminal_is_kept_on_its_record_with_whom_and_what() {
+    let s = session();
+    let a = run(&s, &["sh", "-c", "sleep 100"]);
+    let b = run(&s, &["--name", "reviewer", "cat"]);
+    let mut events = s.connect();
+    events.call(1, "events.subscribe", serde_json::json!({}));
+    let send = |text: &str, to: &str| {
+        let out = s.cmd().env("HC_TERMINAL_ID", &a).args(["--json", "send", to, text]).output().unwrap();
+        assert!(out.status.success(), "{}", String::from_utf8_lossy(&out.stderr));
+    };
+    send("\n  look at x.rs  \nsecond line", &b);
+    let event = next_event(&mut events, |m| m["params"]["type"] == "sent");
+    assert_eq!(event["params"]["terminal"], a.as_str());
+    assert_eq!(event["params"]["data"]["sent"][0]["to"], b.as_str());
+    send("again", "reviewer"); // by name: kept under its address
+    let sent = &get(&s, &a)["sent"];
+    assert_eq!(sent.as_array().unwrap().len(), 1, "{sent}");
+    assert_eq!(sent[0]["count"], 2);
+    assert_eq!(sent[0]["text"], "again");
+    assert!(sent[0]["last_ms"].as_u64().unwrap() > 0);
+    assert!(get(&s, &b).get("sent").is_none(), "the receiver's record says nothing");
+
+    // Without a caller (a shell outside hc) nothing is kept; the record survives a restart.
+    s.json(&["send", &b, "from outside"]);
+    s.hc(&["server", "restart"]);
+    assert_eq!(get(&s, &a)["sent"][0]["count"], 2);
+}
