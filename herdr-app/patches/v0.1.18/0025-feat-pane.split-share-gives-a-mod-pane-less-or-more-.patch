+    /// Gives `new` `share` (0..1) of the room it and its sibling `keep` hold together (both weighted).
+    pub fn reshare(&mut self, keep: &str, new: &str, share: f32) -> bool {
+        let Some(parent) = self.parent_of(new).map(|p| p.id.clone()) else { return false };
+        let Some(c) = self.find_mut(&parent).and_then(Node::children_mut) else { return false };
+        let weight = |n: &Node| match n.size {
+            Some(Size::Weight { weight }) => Some(weight),
+            None => Some(1.0),
+            Some(Size::Px { .. }) => None,
+        };
+        let (Some(k), Some(n)) = (c.iter().position(|x| x.id == keep), c.iter().position(|x| x.id == new)) else { return false };
+        let (Some(wk), Some(wn)) = (weight(&c[k]), weight(&c[n])) else { return false };
+        let share = share.clamp(0.1, 0.9);
+        c[k].size = Some(Size::Weight { weight: (wk + wn) * (1.0 - share) });
+        c[n].size = Some(Size::Weight { weight: (wk + wn) * share });
+        true
+    }
+
