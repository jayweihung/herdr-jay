-fn changes(base: &Path, event: notify::Result<notify::Event>) -> (Changed, bool) {
+/// A file or folder in the home folder that is a link to somewhere else (a mod
+/// or a layout kept in its own repo): the OS watcher on the home folder doesn't
+/// follow it, so its target is watched too and changes there count as `rel`'s.
+#[derive(Clone, Debug, PartialEq)]
+struct Link {
+    target: PathBuf,
+    rel: PathBuf,
+    dir: bool,
+}
+
+/// The links in the places `watched` covers, whose targets are outside `root`
+/// (read once at start; a link made later is watched after a restart).
+fn links(root: &Path) -> Vec<Link> {
+    let mut found = Vec::new();
+    let mut look = |rel: PathBuf| {
+        let path = root.join(&rel);
+        if !std::fs::symlink_metadata(&path).is_ok_and(|m| m.file_type().is_symlink()) {
+            return;
+        }
+        let Ok(target) = path.canonicalize() else { return };
+        if !target.starts_with(root) {
+            found.push(Link { dir: target.is_dir(), target, rel });
+        }
+    };
+    for name in ["settings.json", "keys.json", "programs.json"] {
+        look(PathBuf::from(name));
+    }
+    for folder in ["mods", "layouts", "themes"] {
+        for entry in std::fs::read_dir(root.join(folder)).into_iter().flatten().flatten() {
+            look(Path::new(folder).join(entry.file_name()));
+        }
+    }
+    found
+}
+
+/// A path the OS reported, as a path in the home folder (through a link's target).
+fn in_home(base: &Path, links: &[Link], path: &Path) -> Option<PathBuf> {
+    if let Ok(rel) = path.strip_prefix(base) {
+        return Some(rel.to_path_buf());
+    }
+    links.iter().find_map(|l| if l.dir {
+        path.strip_prefix(&l.target).ok().map(|rest| l.rel.join(rest))
+    } else {
+        (path == l.target).then(|| l.rel.clone())
+    })
+}
+
+fn changes(base: &Path, links: &[Link], event: notify::Result<notify::Event>) -> (Changed, bool) {
     let Ok(event) = event else { return (Vec::new(), true) };
     if !event.need_rescan() && matches!(event.kind, notify::EventKind::Access(_)) {
         return (Vec::new(), false);
@@ -61,8 +108,8 @@ fn changes(base: &Path, event: notify::Result<notify::Event>) -> (Changed, bool)
     let rescan = event.need_rescan() || event.paths.iter().any(|path| {
         base.starts_with(path) || path.strip_prefix(base).is_ok_and(|relative| relative.starts_with("mods") && mod_of(relative).is_none())
     });
-    let changed = event.paths.iter().filter_map(|path| path.strip_prefix(base).ok())
-        .filter(|path| watched(path)).map(Path::to_path_buf).collect();
+    let changed = event.paths.iter().filter_map(|path| in_home(base, links, path))
+        .filter(|path| watched(path)).collect();
     (changed, rescan)
 }
 
