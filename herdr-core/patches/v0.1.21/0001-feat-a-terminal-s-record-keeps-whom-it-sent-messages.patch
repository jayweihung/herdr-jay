+
+#[test]
+fn whom_a_terminal_sent_to_reads_right_from_either_machine() {
+    let (rohan, s) = with_rohan();
+    let here = run(&s, &["sh", "-c", "sleep 100"]);
+    let there = run(&s, &["--on", "rohan", "cat"]);
+    let send = |s: &Session, from: &str, to: &str| {
+        let out = s.cmd().env("HC_TERMINAL_ID", from).args(["send", to, "hi"]).output().unwrap();
+        assert!(out.status.success(), "{}", String::from_utf8_lossy(&out.stderr));
+    };
+    send(&s, &here, &there);
+    assert_eq!(get(&s, &here)["sent"][0]["to"], there.as_str(), "kept by this machine's name for it");
+
+    // Two terminals over there talking: seen from here under rohan's name.
+    let local = there.split_once('/').unwrap().1;
+    let other = run(&rohan, &["sh", "-c", "sleep 100"]);
+    send(&rohan, &other, local);
+    let seen = format!("rohan/{other}");
+    wait_until("the record here", || get(&s, &seen)["sent"][0]["to"] == there.as_str());
+}
